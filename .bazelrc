# Curated flag presets generated by bazelrc-preset.bzl (run `tools/repin` to
# regenerate). Kept separate so it can be regenerated without touching this file.
import %workspace%/bazel/preset.bazelrc

# See https://aspect.build/blog/configuring-bazels-downloader
common --downloader_config=bazel/downloader.cfg



# Select the uv hub's dependency group (matches project name in pyproject.toml).
common --@pypi//dep_group=garage_rag
# Select the hermetic 3.13 interpreter from @python_interpreters. Its toolchains
# are gated on this flag (target_settings = python_version_is_3_13); without it,
# resolution falls through to a transitively-registered rules_python interpreter.
common --@aspect_rules_py//py/private/interpreter:python_version=3.13




# Load settings & overrides specific to the current user from `user.bazelrc`.
# That file is git-ignored so settings aren't shared with team members. This is
# the last statement in this config so user settings can override flags set
# above. See https://bazel.build/configure/best-practices#bazelrc-file.
try-import %workspace%/user.bazelrc

# Automatically look up your local codesigning identity from your macOS Keychain
build --apple_generate_dsym
build --custom_malloc=@bazel_tools//tools/cpp:malloc
build --macos_cpus=arm64,x86_64

# Pass the specific signing identity name if you want to enforce a specific Team
build --ios_signing_cert_name="Apple Development: Rick Penwell (23E5F7Z5L7)"
build --@rules_apple//apple/build_settings:signing_certificate_name="Developer ID Application: Richard Penwell (DWVXMLB45Y)"
