load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_apple//apple:apple.bzl", "apple_dynamic_framework_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")
load("//bazel:codesign.bzl", "codesign")

configure_make(
    name = "python_3_13",
    args = [
        "-e",
    ],
    configure_in_place = True,
    configure_options = [
        "--enable-framework=$$INSTALLDIR$$/",
        "--without-ensurepip",
        "--with-static-libpython",
        "--with-universal-archs",
        "--with-openssl=$$EXT_BUILD_DEPS/openssl",
        "--with-readline=readline",
    ],
    copts = [
        "-DDATE=\\\"\\\\\\\"Jan_01_1970\\\\\\\"\\\"",
        "-DTIME=\\\"\\\\\\\"00:00:00\\\\\\\"\\\"",
    ],
    env = {
        "AR": "/usr/bin/ar",
        "ARFLAGS": "crs",
        "LIBREADLINE_LIBS": "-lreadline -lncurses",
        "PYTHONAPPSDIR": "$$INSTALLDIR$$/",
    },
    lib_source = "@python_3_13_framework//:python_source",
    out_binaries = [
        "python3",
        "python3-config",
    ],
    out_data_dirs = [
        "Python.framework",
        "bin/python3.dSYM",
    ],
    postfix_script = """
for f in $$INSTALLDIR/bin/*; do
    if [ -f "$$f" ] && [ -x "$$f" ]; then
        dsymutil "$$f" -o "$$f.dSYM" || true
    fi
done
find $$INSTALLDIR/Python.framework -type f \\( -perm -111 -o -name "*.dylib" -o -name "*.so" \\) 2>/dev/null | while IFS= read -r f; do
    if file -b "$$f" | grep -q "Mach-O"; then
        dsymutil "$$f" -o "$$f.dSYM" || true
    fi
done
""",
    visibility = ["//visibility:public"],
    deps = [
        "//ext:libreadline",
        "//ext:libzlib",
        "//ext:openssl",
    ],
)

configure_make(
    name = "python_3_13_static",
    args = [
        "-e",
    ],
    configure_in_place = True,
    configure_options = [
        "--without-ensurepip",
        "--with-static-libpython",
        "--with-universal-archs",
        "--with-openssl=$$EXT_BUILD_DEPS/openssl",
        "--with-readline=readline",
    ],
    copts = [
        "-DDATE=\\\"\\\\\\\"Jan_01_1970\\\\\\\"\\\"",
        "-DTIME=\\\"\\\\\\\"00:00:00\\\\\\\"\\\"",
    ],
    env = {
        "AR": "/usr/bin/ar",
        "ARFLAGS": "crs",
        "LIBREADLINE_LIBS": "-lreadline -lncurses",
    },
    lib_source = "@python_3_13_framework//:python_source",
    out_binaries = [
        "python3",
        "python3-config",
    ],
    out_include_dir = "include/python3.13",
    out_static_libs = [
        "libpython3.13.a",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//ext:libreadline",
        "//ext:libzlib",
        "//ext:openssl",
    ],
)

alias(
    name = "python_3_13_framework",
    actual = ":python_3_13",
    visibility = ["//visibility:public"],
)

# Raw install tree of the framework build (Python.framework/, bin/, include/).
filegroup(
    name = "python_3_13_install_dir",
    srcs = [":python_3_13"],
    output_group = "gen_dir",
)

# Header-only target exposing <Python.h> from the framework build so that host
# code can use the PyConfig embedding API. It deliberately does NOT link
# libpython: consumers link `-framework Python` (the bundled Python.framework)
# so exactly one interpreter is present in the process.
cc_library(
    name = "python_headers",
    hdrs = [":python_3_13_install_dir"],
    includes = ["copy_python_3_13/python_3_13/Python.framework/Versions/3.13/include/python3.13"],
    visibility = ["//visibility:public"],
)

alias(
    name = "python_3_14_framework",
    actual = ":python_3_13",
    visibility = ["//visibility:public"],
)

copy_to_directory(
    name = "python_framework_raw",
    srcs = [":python_3_13"],
    out = "python_framework_raw",
    exclude_srcs_patterns = [
        "**/Versions/*/lib/**",
        "**/Versions/*/lib",
        "**/Versions/3.13/lib/**",
        "**/Versions/3.13/lib",
        "**/Versions/Current/lib/**",
        "**/Versions/Current/lib",
        "**/lib/**",
        "**/lib",
    ],
    include_srcs_patterns = [
        "python_3_13/Python.framework/**",
    ],
    replace_prefixes = {
        "python_3_13": "",
    },
)

codesign(
    name = "python_framework",
    src = ":python_framework_raw",
    out = "Python.framework",
    is_framework = True,
    signing_identity = select({
        "//bazel:is_adhoc": "-",
        "//bazel:is_store": "Apple Distribution: Richard Penwell (DWVXMLB45Y)",
        "//conditions:default": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
    }),
    visibility = ["//visibility:public"],
)

apple_dynamic_framework_import(
    name = "Python",
    framework_imports = [":python_framework"],
    visibility = ["//visibility:public"],
)

alias(
    name = "python_framework_import",
    actual = ":Python",
    visibility = ["//visibility:public"],
)
