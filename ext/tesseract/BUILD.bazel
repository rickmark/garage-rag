load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")
load("//bazel:foreign_cc.bzl", "extract_foreign_cc_file", "normalize_install_names")

# libtesseract, loaded in-process by garage_rag.extract.tesseract through its C API
# (capi.h), with //ext/leptonica linked in statically so the app ships one dylib that
# depends only on system libraries.
cmake(
    name = "tesseract_build",
    build_args = [
        "--",
        "-j",
    ],
    cache_entries = {
        "BUILD_SHARED_LIBS": "ON",
        "BUILD_TESTS": "OFF",
        "BUILD_TRAINING_TOOLS": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "DISABLE_ARCHIVE": "ON",
        "DISABLE_CURL": "ON",
        "DISABLE_TIFF": "ON",
        "ENABLE_LTO": "OFF",
        "GRAPHICS_DISABLED": "ON",
        "INSTALL_CONFIGS": "OFF",
        "Leptonica_DIR": "$$EXT_BUILD_DEPS/leptonica/lib/cmake/leptonica",
        "OPENMP_BUILD": "OFF",
    },
    # Pin `cmake --build/--install --config` to CMAKE_BUILD_TYPE. Left unset, rules_foreign_cc
    # passes `--config Debug` under compilation_mode=dbg (the rules_xcodeproj build), and the
    # install then skips the Release-only `*Targets-release.cmake` export.
    configuration = "Release",
    env = {
        "AR": "/usr/bin/ar",
        # //ext/leptonica has no codecs, so two things that would use one are switched off:
        # DebugPixa's caption fonts (TIFF-encoded; four "Error in pixReadMemTiff" lines
        # per image) and ImageData encoding each text line to PNG in memory before the
        # LSTM reads it back (falls back to PNM with a warning). Keeping the line as a Pix
        # skips the encode/decode round trip as well.
        "CXXFLAGS": "-DTESSERACT_DISABLE_DEBUG_FONTS -DTESSERACT_IMAGEDATA_AS_PIX",
    },
    lib_source = "@tesseract//:tesseract_source",
    out_shared_libs = ["libtesseract.5.5.dylib"],
    postfix_script = normalize_install_names(["libtesseract.5.5.dylib"]),
    visibility = ["//visibility:public"],
    deps = ["//ext/leptonica"],
)

extract_foreign_cc_file(
    name = "libtesseract_dylib",
    out = "lib/libtesseract.5.5.dylib",
    filename = "libtesseract.5.5.dylib",
    target = ":tesseract_build",
)

filegroup(
    name = "tessdata",
    srcs = ["@tessdata_eng//file"],
    visibility = ["//visibility:public"],
)

alias(
    name = "tesseract",
    actual = ":libtesseract_dylib",
    visibility = ["//visibility:public"],
)
