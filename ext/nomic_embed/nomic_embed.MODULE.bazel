http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# nomic-embed-text v1.5 at Q2_K, the smallest quantization published (49.4 MB), Apache-2.0.
# LlamaXPCService ships it only to check llama.cpp end to end against known answers
# (known_answers.json, regenerated by tools/llama/gen_known_answers.sh). It is not the
# nomic-embed-text in the Models catalog (docs/.data/models.json pins the Q8_0 file), and its
# vectors never go into a corpus table: another quantization gives other vectors.
# The URL names the repository revision, so the file behind it cannot move.
http_file(
    name = "nomic_embed_text_q2k",
    downloaded_file_path = "nomic-embed-text-v1.5.Q2_K.gguf",
    sha256 = "a25579241bc4d68d246fe9e12720dda4ed2f735d18e677a207d01d55591f6907",
    urls = ["https://huggingface.co/nomic-ai/nomic-embed-text-v1.5-GGUF/resolve/0188c9bf409793f810680a5a431e7b899c46104c/nomic-embed-text-v1.5.Q2_K.gguf"],
)
