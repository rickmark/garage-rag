load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "make")
load(":age.bzl", "GENERATED")

exports_files(["age.BUILD.bazel"])

# Apache AGE (graph database / openCypher) as a PGXS extension, built like //ext/pgvector
# against whichever Postgres //ext:postgres_version selects. AGE ships one source line per
# major version, so the source follows the same flag.
make(
    name = "age",
    # -e lets the env below override PGXS's paths (pg_config reports the sandbox it was built
    # in). -o: the parser and scanner come pre-generated from age_source; never remake them.
    args = ["-e"] + [
        arg
        for path in GENERATED
        for arg in [
            "-o",
            path,
        ]
    ],
    env = {
        "PG_CONFIG": "$$EXT_BUILD_DEPS/postgres/bin/pg_config",
        # Replaces the Makefile's own PG_CPPFLAGS under -e, so AGE's include dirs go here too.
        "PG_CPPFLAGS": " ".join([
            "-Isrc/include",
            "-Isrc/include/parser",
            "-I$$EXT_BUILD_DEPS/postgres/include/server",
            "-I$$EXT_BUILD_DEPS/postgres/include/internal",
        ]),
        "pkglibdir": "$$INSTALLDIR/lib",
        "datadir": "$$INSTALLDIR/share",
        "pkgincludedir": "$$INSTALLDIR/include",
        # Postgres's own code-generation flags; AGE carries backend code that relies on them.
        "CFLAGS": "-g -O2 -fno-strict-aliasing -fwrapv",
        "CXXFLAGS": "-g",
        # Generated in Bazel already (see age.bzl); fail loudly rather than run the host's.
        "BISON": "false",
        "FLEX": "false",
        # cypher_kwlist_d.h is still generated by make, with Postgres's gen_keywordlist.pl.
        "PERL": "perl",
    },
    lib_source = select({
        "//ext:postgres_19": "//ext/age/pg19:age_source",
        "//conditions:default": "//ext/age/pg18:age_source",
    }),
    out_data_dirs = [
        "share",
        "lib/age.dylib.dSYM",
    ],
    out_shared_libs = [
        "age.dylib",
    ],
    postfix_script = "dsymutil $$INSTALLDIR/lib/age.dylib -o $$INSTALLDIR/lib/age.dylib.dSYM",
    # lib_source is one generated directory (age_source, see age.bzl). rules_foreign_cc takes
    # its parent as the source root and links it into the build dir, read-only, so give make a
    # writable copy of the tree first. `exec "$@"` keeps make on the same command line, so it
    # still gets the toolchain variables rules_foreign_cc sets inline; the copy runs once.
    tool_prefix = "sh -c '[ -f Makefile ] || cp -RL age_source/. . && chmod -R u+w . && exec \"$$@\"' sh",
    visibility = ["//visibility:public"],
    deps = [
        "//ext:postgres",
    ],
)

# CI's macOS job runs `aspect test //...` with --build_tests_only, and nothing else under test
# depends on the Postgres bundle, so this is what makes it compile AGE (parser generation,
# the source overlay and the age.dylib link) on every change to its build inputs.
build_test(
    name = "age_build_test",
    targets = [":age"],
)
