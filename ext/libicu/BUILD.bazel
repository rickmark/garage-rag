load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")
load("//bazel:codesign.bzl", "macho_test")
load("//bazel:foreign_cc.bzl", "extract_foreign_cc_file", "normalize_install_names")

configure_make(
    name = "libicu",
    configure_command = "source/configure",
    configure_options = [
        "--disable-samples",
        "--disable-tests",
        "--enable-static",
        "--disable-shared",
    ],
    env = {
        "AR": "/usr/bin/ar",
        "CFLAGS": "-arch arm64 -arch x86_64 -g",
        "CXXFLAGS": "-arch arm64 -arch x86_64 -g",
        "LDFLAGS": "-arch arm64 -arch x86_64",
    },
    lib_source = "@libicu//:libicu_source",
    out_static_libs = [
        "libicui18n.a",
        "libicuuc.a",
        "libicudata.a",
        "libicuio.a",
        "libicutu.a",
    ],
    visibility = ["//visibility:public"],
)

# Shared build, consumed only by //ext/postgres:postgres, so the app ships one copy of ICU
# under postgres/lib instead of a static copy baked into every Postgres binary and dylib.
configure_make(
    name = "libicu_shared",
    configure_command = "source/configure",
    configure_options = [
        "--disable-samples",
        "--disable-tests",
        "--disable-static",
        "--enable-shared",
    ],
    env = {
        "AR": "/usr/bin/ar",
        "CFLAGS": "-arch arm64 -arch x86_64 -g",
        "CXXFLAGS": "-arch arm64 -arch x86_64 -g",
        "LDFLAGS": "-arch arm64 -arch x86_64",
    },
    lib_source = "@libicu//:libicu_source",
    out_shared_libs = [
        "libicudata.76.dylib",
        "libicui18n.76.dylib",
        "libicuio.76.dylib",
        "libicutu.76.dylib",
        "libicuuc.76.dylib",
    ],
    postfix_script = normalize_install_names([
        "libicudata.76.dylib",
        "libicui18n.76.dylib",
        "libicuio.76.dylib",
        "libicutu.76.dylib",
        "libicuuc.76.dylib",
    ]),
    visibility = ["//visibility:public"],
)

extract_foreign_cc_file(
    name = "libicudata_dylib",
    out = "lib/libicudata.76.dylib",
    filename = "libicudata.76.dylib",
    target = ":libicu_shared",
)

extract_foreign_cc_file(
    name = "libicui18n_dylib",
    out = "lib/libicui18n.76.dylib",
    filename = "libicui18n.76.dylib",
    target = ":libicu_shared",
)

extract_foreign_cc_file(
    name = "libicuio_dylib",
    out = "lib/libicuio.76.dylib",
    filename = "libicuio.76.dylib",
    target = ":libicu_shared",
)

extract_foreign_cc_file(
    name = "libicutu_dylib",
    out = "lib/libicutu.76.dylib",
    filename = "libicutu.76.dylib",
    target = ":libicu_shared",
)

extract_foreign_cc_file(
    name = "libicuuc_dylib",
    out = "lib/libicuuc.76.dylib",
    filename = "libicuuc.76.dylib",
    target = ":libicu_shared",
)

filegroup(
    name = "libicu_dylibs",
    srcs = [
        ":libicudata_dylib",
        ":libicui18n_dylib",
        ":libicuio_dylib",
        ":libicutu_dylib",
        ":libicuuc_dylib",
    ],
    visibility = ["//visibility:public"],
)

macho_test(
    name = "libicu_arch_test",
    src = ":libicu",
    archs = [
        "arm64",
        "x86_64",
    ],
)

macho_test(
    name = "libicu_shared_arch_test",
    src = ":libicu_dylibs",
    archs = [
        "arm64",
        "x86_64",
    ],
)
