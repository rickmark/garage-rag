load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")
load("//bazel:codesign.bzl", "macho_test")
load("//bazel:foreign_cc.bzl", "extract_foreign_cc_file", "normalize_install_names")

configure_make(
    name = "libzlib",
    configure_command = "configure",
    configure_options = [
        "--static",
    ],
    env = {
        "AR": "/usr/bin/ar",
        "CFLAGS": "-arch arm64 -arch x86_64 -g",
        "CXXFLAGS": "-arch arm64 -arch x86_64 -g",
        "LDFLAGS": "-arch arm64 -arch x86_64",
    },
    lib_source = "@libzlib//:libzlib_source",
    out_static_libs = [
        "libz.a",
    ],
    visibility = ["//visibility:public"],
)

# Shared build, consumed only by //ext/postgres:postgres; see //ext/libicu:libicu_shared.
configure_make(
    name = "libzlib_shared",
    configure_command = "configure",
    configure_options = [
        "--shared",
    ],
    env = {
        "AR": "/usr/bin/ar",
        "CFLAGS": "-arch arm64 -arch x86_64 -g",
        "CXXFLAGS": "-arch arm64 -arch x86_64 -g",
        "LDFLAGS": "-arch arm64 -arch x86_64",
    },
    lib_source = "@libzlib//:libzlib_source",
    out_shared_libs = [
        "libz.1.dylib",
    ],
    postfix_script = normalize_install_names(["libz.1.dylib"]),
    visibility = ["//visibility:public"],
)

extract_foreign_cc_file(
    name = "libz_dylib",
    out = "lib/libz.1.dylib",
    filename = "libz.1.dylib",
    target = ":libzlib_shared",
)

filegroup(
    name = "libzlib_dylibs",
    srcs = [":libz_dylib"],
    visibility = ["//visibility:public"],
)

macho_test(
    name = "libzlib_arch_test",
    src = ":libzlib",
    archs = [
        "arm64",
        "x86_64",
    ],
)

macho_test(
    name = "libzlib_shared_arch_test",
    src = ":libzlib_dylibs",
    archs = [
        "arm64",
        "x86_64",
    ],
)
