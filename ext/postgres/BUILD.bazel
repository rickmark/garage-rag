load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

configure_make(
    name = "postgres",
    # Flags passed directly to the GNU ./configure script
    configure_options = [
        "--without-readline",
        "--without-zlib",
        "--without-icu",
        # Keep features minimal unless your system provides headers (like OpenSSL)
    ],
    copts = [
        "-Wno-error=unguarded-availability-new",
        "-Wno-unguarded-availability-new",
    ],
    env = {
        "AR": "/usr/bin/ar",
        "ARFLAGS": "crs",
    },
    lib_source = "@postgres//:postgres_source",
    out_binaries = [
        "psql",
        "postgres",
        "initdb",
        "pg_config",
    ],

    # Inform Bazel which static output archive to catch
    out_static_libs = ["libpq.a"],
    visibility = ["//visibility:public"],
)
