load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")
load("//bazel:rpath.bzl", "install_name")

configure_make(
    name = "postgres",
    configure_in_place = True,
    # Flags passed directly to the GNU ./configure script
    configure_options = [
        "--with-icu",
        "--with-readline",
        "--with-zlib",
        "--with-template=darwin",
        "--disable-rpath",
    ],
    copts = [
        "-Wno-error=unguarded-availability-new",
        "-Wno-unguarded-availability-new",
    ],
    env = {
        "AR": "/usr/bin/ar",
        "ARFLAGS": "crs",
        "CFLAGS": "-arch arm64 -arch x86_64 -g",
        "CXXFLAGS": "-arch arm64 -arch x86_64 -g",
        "LDFLAGS": "-arch arm64 -arch x86_64",
    },
    lib_source = "@postgres//:postgres_source",
    out_binaries = [
        "initdb",
        "createdb",
        "pg_config",
        "pg_dump",
        "psql",
        "postgres",
        "pg_isready",
        "pg_ctl",
        "pg_restore",
        "dropdb",
        "dropuser",
    ],
    out_data_dirs = [
        "bin/createdb.dSYM",
        "bin/dropdb.dSYM",
        "bin/dropuser.dSYM",
        "bin/initdb.dSYM",
        "bin/pg_config.dSYM",
        "bin/pg_ctl.dSYM",
        "bin/pg_dump.dSYM",
        "bin/pg_isready.dSYM",
        "bin/pg_restore.dSYM",
        "bin/postgres.dSYM",
        "bin/psql.dSYM",
        "lib/dict_snowball.dylib.dSYM",
        "lib/libecpg.dylib.dSYM",
        "lib/libpgtypes.3.dylib.dSYM",
        "lib/libpgtypes.dylib.dSYM",
        "lib/libpq.5.dylib.dSYM",
        "lib/libpq.dylib.dSYM",
        "lib/pgoutput.dylib.dSYM",
        "lib/pg_trgm.dylib.dSYM",
        "lib/plpgsql.dylib.dSYM",
        "share",
    ],
    out_data_files = [
        "lib/pgxs/src/makefiles/pgxs.mk",
    ],
    out_shared_libs = [
        "libpq.dylib",
        "plpgsql.dylib",
        "pg_trgm.dylib",
        "libpgtypes.dylib",
        "libpq.5.dylib",
        "libpgtypes.3.dylib",
        "libecpg.dylib",
        "pgoutput.dylib",
        "dict_snowball.dylib",
    ],
    out_static_libs = [
        "libecpg.a",
        "libpq.a",
        "libpgport.a",
        "libpgtypes.a",
        "libpgcommon.a",
    ],
    postfix_script = """
for f in $$INSTALLDIR/bin/*; do
    if [ -f "$$f" ] && [ -x "$$f" ]; then
        dsymutil "$$f" -o "$$f.dSYM" || true
    fi
done
for f in $$INSTALLDIR/lib/*.dylib; do
    if [ -f "$$f" ]; then
        dsymutil "$$f" -o "$$f.dSYM" || true
    fi
done
for conf in "$$INSTALLDIR"/share/postgresql.conf "$$INSTALLDIR"/share/postgresql/postgresql.conf "$$INSTALLDIR"/share/postgresql.conf.sample "$$INSTALLDIR"/share/postgresql/postgresql.conf.sample; do
    if [ -f "$$conf" ]; then
        sed -i.bak -e 's/^[# ]*shared_memory_type = .*/shared_memory_type = mmap/' \
                   -e 's/^[# ]*dynamic_shared_memory_type = .*/dynamic_shared_memory_type = mmap/' \
                   "$$conf"
        rm -f "$$conf.bak"
    fi
done
""",
    targets = [
        "world-bin",
        "install-world-bin",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//ext/libicu:libicu_shared",
        "//ext/libreadline:libreadline_shared",
        "//ext/libzlib:libzlib_shared",
    ],
)

install_name(
    name = "postgres_rpath",
    deps = [
        ":postgres",
        "//ext/libicu:libicu_dylibs",
        "//ext/libreadline:libreadline_dylibs",
        "//ext/libzlib:libzlib_dylibs",
    ],
    visibility = ["//visibility:public"],
)

genrule(
    name = "libpq_a",
    srcs = [":postgres"],
    outs = ["libpq.a"],
    cmd = """
for f in $(locations :postgres); do
    if [ "$$(basename "$$f")" = "libpq.a" ]; then
        cp "$$f" "$@"
        break
    fi
done
""",
)

genrule(
    name = "libpgcommon_a",
    srcs = [":postgres"],
    outs = ["libpgcommon.a"],
    cmd = """
for f in $(locations :postgres); do
    if [ "$$(basename "$$f")" = "libpgcommon.a" ]; then
        cp "$$f" "$@"
        break
    fi
done
""",
)

genrule(
    name = "libpgport_a",
    srcs = [":postgres"],
    outs = ["libpgport.a"],
    cmd = """
for f in $(locations :postgres); do
    if [ "$$(basename "$$f")" = "libpgport.a" ]; then
        cp "$$f" "$@"
        break
    fi
done
""",
)

# Standalone client library, embedded into the app as `Contents/Frameworks/libpq.dylib`
# (signed by //macapp/externals:libpq) and loaded by psycopg through ctypes. The install
# name is normalised to `@rpath/libpq.dylib` so the same binary works from any location.
genrule(
    name = "libpq_dylib",
    srcs = [":postgres"],
    outs = ["libpq.dylib"],
    cmd = """
src=""
for f in $(locations :postgres); do
    case "$$(basename "$$f")" in
        libpq.5.dylib) src="$$f"; break ;;
        libpq.dylib) [ -z "$$src" ] && src="$$f" ;;
    esac
done
if [ -z "$$src" ]; then
    echo "libpq_dylib: libpq.dylib not found in //ext/postgres:postgres outputs" >&2
    exit 1
fi
cp -L "$$src" "$@"
chmod u+w "$@"
/usr/bin/install_name_tool -id "@rpath/libpq.dylib" "$@"
""",
    visibility = ["//visibility:public"],
)

cc_import(
    name = "libpq_import",
    static_library = ":libpq_a",
    visibility = ["//visibility:private"],
)

cc_import(
    name = "libpgcommon_import",
    static_library = ":libpgcommon_a",
    visibility = ["//visibility:private"],
)

cc_import(
    name = "libpgport_import",
    static_library = ":libpgport_a",
    visibility = ["//visibility:private"],
)

cc_library(
    name = "libpq",
    deps = [
        ":libpq_import",
        ":libpgcommon_import",
        ":libpgport_import",
        "//ext:libicu",
        "//ext:libreadline",
        "//ext:libzlib",
    ],
    visibility = ["//visibility:public"],
)
