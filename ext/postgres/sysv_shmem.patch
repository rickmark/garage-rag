+
+typedef struct PGSemaphoreData
+{
+	pthread_mutex_t mutex;
+	pthread_cond_t	cond;
+	int				count;
+	char			pad[PG_CACHE_LINE_SIZE];
+} PGSemaphoreData;
+
+static PGSemaphore sharedSemas; /* array of PGSemaphoreData in shared memory */
+static int	numSems;			/* number of semas acquired so far */
+static int	maxSems;			/* allocated size of above arrays */
+
+static void ReleaseSemaphores(int status, Datum arg);
+
+/*
+ * Report amount of shared memory needed for semaphores
+ */
+Size
+PGSemaphoreShmemSize(int maxSemas)
+{
+	return mul_size(maxSemas, sizeof(PGSemaphoreData));
+}
+
+/*
+ * PGReserveSemaphores --- initialize semaphore support
+ */
+void
+PGReserveSemaphores(int maxSemas)
+{
+	struct stat statbuf;
+
+	if (stat(DataDir, &statbuf) < 0)
+		ereport(FATAL,
+				(errcode_for_file_access(),
+				 errmsg("could not stat data directory \"%s\": %m",
+						DataDir)));
+
+	sharedSemas = (PGSemaphore)
+		ShmemAllocUnlocked(PGSemaphoreShmemSize(maxSemas));
+
+	numSems = 0;
+	maxSems = maxSemas;
+
+	on_shmem_exit(ReleaseSemaphores, 0);
+}
+
+/*
+ * Release semaphores at shutdown or shmem reinitialization
+ */
+static void
+ReleaseSemaphores(int status, Datum arg)
+{
+	int			i;
+
+	for (i = 0; i < numSems; i++)
+	{
+		pthread_mutex_destroy(&sharedSemas[i].mutex);
+		pthread_cond_destroy(&sharedSemas[i].cond);
+	}
+}
+
+/*
+ * PGSemaphoreCreate
+ *
+ * Allocate a PGSemaphore structure with initial count 1
+ */
+PGSemaphore
+PGSemaphoreCreate(void)
+{
+	PGSemaphore sema;
+	pthread_mutexattr_t mattr;
+	pthread_condattr_t cattr;
+
+	/* Can't do this in a backend, because static state is postmaster's */
+	Assert(!IsUnderPostmaster);
+
+	if (numSems >= maxSems)
+		elog(PANIC, "too many semaphores created");
+
+	sema = &sharedSemas[numSems];
+
+	if (pthread_mutexattr_init(&mattr) != 0)
+		elog(FATAL, "pthread_mutexattr_init failed: %m");
+	if (pthread_mutexattr_setpshared(&mattr, PTHREAD_PROCESS_SHARED) != 0)
+		elog(FATAL, "pthread_mutexattr_setpshared failed: %m");
+	if (pthread_mutex_init(&sema->mutex, &mattr) != 0)
+		elog(FATAL, "pthread_mutex_init failed: %m");
+	pthread_mutexattr_destroy(&mattr);
+
+	if (pthread_condattr_init(&cattr) != 0)
+		elog(FATAL, "pthread_condattr_init failed: %m");
+	if (pthread_condattr_setpshared(&cattr, PTHREAD_PROCESS_SHARED) != 0)
+		elog(FATAL, "pthread_condattr_setpshared failed: %m");
+	if (pthread_cond_init(&sema->cond, &cattr) != 0)
+		elog(FATAL, "pthread_cond_init failed: %m");
+	pthread_condattr_destroy(&cattr);
+
+	sema->count = 1;
+
+	numSems++;
+
+	return sema;
+}
+
+/*
+ * PGSemaphoreReset
+ *
+ * Reset a previously-initialized PGSemaphore to have count 0
+ */
+void
+PGSemaphoreReset(PGSemaphore sema)
+{
+	if (pthread_mutex_lock(&sema->mutex) != 0)
+		elog(FATAL, "pthread_mutex_lock failed: %m");
+	sema->count = 0;
+	if (pthread_mutex_unlock(&sema->mutex) != 0)
+		elog(FATAL, "pthread_mutex_unlock failed: %m");
+}
+
+/*
+ * PGSemaphoreLock
+ *
+ * Lock a semaphore (decrement count), blocking if count would be <= 0
+ */
+void
+PGSemaphoreLock(PGSemaphore sema)
+{
+	if (pthread_mutex_lock(&sema->mutex) != 0)
+		elog(FATAL, "pthread_mutex_lock failed: %m");
+	while (sema->count <= 0)
+	{
+		if (pthread_cond_wait(&sema->cond, &sema->mutex) != 0)
+			elog(FATAL, "pthread_cond_wait failed: %m");
+	}
+	sema->count--;
+	if (pthread_mutex_unlock(&sema->mutex) != 0)
+		elog(FATAL, "pthread_mutex_unlock failed: %m");
+}
+
+/*
+ * PGSemaphoreUnlock
+ *
+ * Unlock a semaphore (increment count)
+ */
+void
+PGSemaphoreUnlock(PGSemaphore sema)
+{
+	if (pthread_mutex_lock(&sema->mutex) != 0)
+		elog(FATAL, "pthread_mutex_lock failed: %m");
+	sema->count++;
+	if (pthread_cond_signal(&sema->cond) != 0)
+		elog(FATAL, "pthread_cond_signal failed: %m");
+	if (pthread_mutex_unlock(&sema->mutex) != 0)
+		elog(FATAL, "pthread_mutex_unlock failed: %m");
+}
+
+/*
+ * PGSemaphoreTryLock
+ *
+ * Lock a semaphore only if able to do so without blocking
+ */
+bool
+PGSemaphoreTryLock(PGSemaphore sema)
+{
+	bool		result = false;
+
+	if (pthread_mutex_lock(&sema->mutex) != 0)
+		elog(FATAL, "pthread_mutex_lock failed: %m");
+	if (sema->count > 0)
+	{
+		sema->count--;
+		result = true;
+	}
+	if (pthread_mutex_unlock(&sema->mutex) != 0)
+		elog(FATAL, "pthread_mutex_unlock failed: %m");
+
+	return result;
+}
+
+#endif							/* USE_UNNAMED_POSIX_SEMAPHORES */
