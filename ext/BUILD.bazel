# The per-dependency codesign_test targets live next to the rules that produce
# the binaries they check (//ext/python); this suite keeps
# `bazel test //ext:tests` covering all of them.
test_suite(
    name = "tests",
    tests = [
        "//ext/python:python_framework_codesign_test",
    ],
)
