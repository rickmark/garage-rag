load("//bazel:codesign.bzl", "HARDENED_RUNTIME_EXPECTED", "codesign_test", "macho_test")

alias(
    name = "PythonKit",
    actual = "@PythonKit//:PythonKit",
    visibility = ["//visibility:public"],
)

alias(
    name = "pythonkit",
    actual = ":PythonKit",
    visibility = ["//visibility:public"],
)

# PythonKit is linked statically into PythonXPCService.framework; there is no
# separate PythonKit.framework anymore. Kept for consumers using the old name.
alias(
    name = "PythonKit_swift",
    actual = ":PythonKit",
    visibility = ["//visibility:public"],
)

macho_test(
    name = "pythonkit_arch_test",
    src = ":PythonKit",
    archs = ["arm64"],
)

codesign_test(
    name = "pythonkit_codesign_test",
    src = ":PythonKit",
    hardened_runtime = HARDENED_RUNTIME_EXPECTED,
    is_store = select({
        "//bazel:is_store": True,
        "//conditions:default": False,
    }),
    signing_identity = select({
        "//bazel:is_developer_id": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
        "//bazel:is_store": "Apple Distribution: Richard Penwell (DWVXMLB45Y)",
        "//conditions:default": "-",
    }),
)
