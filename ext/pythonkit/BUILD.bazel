load("//bazel:codesign.bzl", "EXPECTED_SIGNING_IDENTITY", "HARDENED_RUNTIME_EXPECTED", "STORE_EXPECTED", "codesign_test")

alias(
    name = "PythonKit",
    actual = "@PythonKit//:PythonKit",
    visibility = ["//visibility:public"],
)

alias(
    name = "pythonkit",
    actual = ":PythonKit",
    visibility = ["//visibility:public"],
)

# PythonKit is linked statically into PythonXPCService.framework; there is no
# separate PythonKit.framework anymore. Kept for consumers using the old name.
alias(
    name = "PythonKit_swift",
    actual = ":PythonKit",
    visibility = ["//visibility:public"],
)

codesign_test(
    name = "pythonkit_codesign_test",
    src = ":PythonKit",
    hardened_runtime = HARDENED_RUNTIME_EXPECTED,
    is_store = STORE_EXPECTED,
    signing_identity = EXPECTED_SIGNING_IDENTITY,
)
