http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "PythonKit",
    build_file = "@//ext/pythonkit:PythonKit.BUILD.bazel",
    # PythonKit falls back to /opt/homebrew/Frameworks and /usr/local/Frameworks when Python is not
    # already loaded. Every binary here links the bundled Python.framework, so that search is dead
    # code, but shipped code must not look into Homebrew at all.
    patch_args = ["-p1"],
    patches = ["@//ext/pythonkit:no-homebrew-search-paths.patch"],
    sha256 = "68cd065a94048c3fc58ca52b8956c59a9f5b1b8c23dda244def9c7266173b877",
    strip_prefix = "PythonKit-0.5.1",
    urls = ["https://github.com/pvieito/PythonKit/archive/refs/tags/v0.5.1.tar.gz"],
)
