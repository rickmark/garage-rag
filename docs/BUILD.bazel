load("//bazel:jekyll.bzl", "jekyll_site")

filegroup(
    name = "sources",
    srcs = glob(
        ["**/*"],
        exclude = [
            "BUILD.bazel",
            "BUILD",
            "Gemfile",
            "Gemfile.lock",
            "_config.yml",
        ],
    ),
)

jekyll_site(
    name = "site",
    srcs = [":sources"],
    config = "_config.yml",
    jekyll = "@bundle//bin:jekyll",
    visibility = ["//visibility:public"],
)

# Served from the site under /.data/ (https://garagerag.app/.data/...), and bundled into the app.
filegroup(
    name = "model_manifest",
    srcs = [".data/models.json"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "config_schema",
    srcs = [".data/garage.schema.json"],
    visibility = ["//visibility:public"],
)
