"""Targets in the repository root"""

exports_files(
    [
    ],
    visibility = ["//:__subpackages__"],
)

# The gazelle binary + `gazelle` runner target live in //tools/gazelle (the
# default target for `aspect gazelle`). Run `aspect gazelle` to generate BUILDs.

platform(
    name = "macos",
    visibility = ["//visibility:public"],
)

alias(
    name = "garage_rag",
    actual = "//garage_python/src/garage_rag",
)

alias(
    name = "macapp",
    actual = "//macapp",
)

alias(
    name = "xcodeproj",
    actual = "//macapp:xcodeproj",
)
