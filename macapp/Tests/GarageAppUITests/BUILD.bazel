load("@rules_apple//apple:macos.bzl", "macos_ui_test")
load("@rules_swift//swift:swift.bzl", "swift_library")

# The base test case and the fixture corpus's description, compiled into
# //macapp/Tests/GarageAppModelUITests too. That bundle cannot link this library: XCTest would
# then run every test here in it as well.
filegroup(
    name = "support_srcs",
    testonly = True,
    srcs = [
        "FixtureCorpus.swift",
        "GarageUITestCase.swift",
    ],
    visibility = ["//macapp/Tests/GarageAppModelUITests:__pkg__"],
)

swift_library(
    name = "GarageAppUITests_lib",
    testonly = True,
    srcs = glob(["**/*.swift"]),
    module_name = "GarageAppUITests",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# XCUITests that drive the real app, each on a throwaway --data-directory. Manual, never part of
# `aspect test //...`: the app's Postgres uses the fixed port 14824 and its quit path stops XPC
# services by executable name, so they refuse to run while another Garage is running, and the test
# runner needs UI automation permission. Run them from the generated Xcode project
# (`aspect run //:xcodeproj`, scheme GarageAppUITests, or `xcodebuild test`); rules_apple's default
# macOS runner injects the bundle into the host like a unit test and has no UI-test mode.
macos_ui_test(
    name = "GarageAppUITests",
    bundle_id = "me.rickmark.garage-rag.GarageAppUITests",
    bundle_name = "GarageAppUITests",
    # Xcode signs the runner (GarageAppUITests-Runner.app) from its sandboxed XCTRunner template
    # plus this target's entitlements. The App Group lets that sandboxed runner write the store
    # tests' data folders in the group container (StoreUITestCase), the one folder the sandboxed
    # store app, its XPC services and the runner all reach.
    entitlements = "//macapp/externals:GarageAppGroup.entitlements",
    minimum_os_version = "14.0",
    # The made-up corpus the tests ingest, as Resources/corpus (GarageUITestCase.copyFixtureCorpus).
    resources = ["//macapp/Tests/Fixtures:corpus_resources"],
    tags = [
        "exclusive",
        "local",
        "manual",
    ],
    test_host = "//macapp/Sources/GarageApp:GarageApp",
    visibility = ["//visibility:public"],
    deps = [":GarageAppUITests_lib"],
)
