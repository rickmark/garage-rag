load("@rules_swift//swift:swift.bzl", "swift_library")

# Test doubles for the llama engine. `LlamaClient(inProcessEngine:)` and `LlamaService` tests drive
# the client against MockLlamaServerEngine without a helper process; DeterministicLlamaEngine is
# the engine of the UI tests' MockLlamaXPCService. Testonly, so no production target can link a
# fake engine.
swift_library(
    name = "LlamaTestSupport",
    testonly = True,
    srcs = glob(["*.swift"]),
    module_name = "LlamaTestSupport",
    visibility = ["//macapp/Tests:__subpackages__"],
    deps = [
        "//macapp/Sources/LlamaClient",
    ],
)
