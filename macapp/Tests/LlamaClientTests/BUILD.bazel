load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift.bzl", "swift_library")

swift_library(
    name = "LlamaClientTests_lib",
    testonly = True,
    srcs = glob(["**/*.swift"]),
    module_name = "LlamaClientTests",
    visibility = ["//visibility:public"],
    deps = [
        "//macapp/Sources/LlamaClient",
        "//macapp/Sources/LlamaServiceHost",
        "//macapp/Tests/LlamaTestSupport",
    ],
)

macos_unit_test(
    name = "LlamaClientTests",
    additional_linker_inputs = [
        "//ext/python:python_framework",
    ],
    bundle_id = "me.rickmark.garage-rag.LlamaClientTests",
    bundle_name = "LlamaClientTests",
    # LlamaClient -> PythonXPCService -> GaragePythonEmbed calls the CPython C
    # API, so the test bundle has to link the interpreter like the app does.
    linkopts = [
        "-F$(location //ext/python:python_framework)/..",
        "-framework",
        "Python",
    ],
    minimum_os_version = "14.0",
    visibility = ["//visibility:public"],
    deps = [
        ":LlamaClientTests_lib",
        "//ext/python:python_framework",
    ],
)
