load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

swift_library(
    name = "GarageApp_lib",
    srcs = glob(["Sources/**/*.swift"]),
    data = [
        "//ext:pgvector",
        "//ext:postgres",
        "//src:garage_rag",
    ],
    module_name = "GarageApp",
    visibility = ["//visibility:private"],
)

macos_application(
    name = "GarageApp",
    bundle_id = "dev.rickmark.garage",
    bundle_name = "GarageApp",
    infoplists = ["//macapp:Info.plist"],
    minimum_os_version = "14.0",
    visibility = ["//visibility:public"],
    deps = [
        ":GarageApp_lib",
    ],
)

alias(
    name = "macapp",
    actual = ":GarageApp",
    visibility = ["//visibility:public"],
)
