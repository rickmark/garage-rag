macapp_version(
    name = "GarageAppVersion",
    short_version_string = "0.9",
    visibility = ["//visibility:public"],
)

macos_application(
    name = "GarageApp",
    additional_contents = {
        ":garage": "MacOS",
        ":garage-mcp": "MacOS",
        ":postgres_output": "Resources/postgres",
        ":schema_output": "Resources/schema",
        "//data/models:model_manifest": "Resources",
        "//data/schema:config_schema": "Resources",
        "//garage_python:site-packages": "Resources/site-packages",
    },
    app_icons = [":GarageApp.xcassets"],
    bundle_id = "me.rickmark.garage-rag",
    bundle_name = "Garage",
    codesignopts = [
        "--options=runtime",  # This enables the Hardened Runtime flag
    ],
    entitlements = select({
        "//bazel:is_store": ":Garage.entitlements",
        "//conditions:default": None,
    }),
    executable_name = "GarageApp",
    frameworks = [
        "//ext/pythonkit:PythonKit_framework",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    provisioning_profile = select({
        "//bazel:is_store": "GarageSplatAppStore.provisionprofile",
        "//conditions:default": None,
    }),
    version = ":GarageAppVersion",
    visibility = ["//visibility:public"],
    xpc_services = [
        "//macapp/Sources/LlamaXPCService:LlamaXPCService",
        "//macapp/Sources/GarageMCPServerService:GarageMCPServerService",
        "//macapp/Sources/GarageEmbedXPCService:GarageEmbedXPCService",
        "//macapp/Sources/GarageIngestXPCService:GarageIngestXPCService",
        "//macapp/Sources/GarageXPCService:GarageXPCService",
        "//macapp/Sources/ModelDownloadXPCService:ModelDownloadXPCService",
    ],
    deps = [
        ":GarageApp_lib",
        "//ext/python:python_framework",
    ],
)

developer_id_macos_application(
    name = "Garage.app",
