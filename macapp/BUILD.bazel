load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_bazel_lib//lib:output_files.bzl", "output_files")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

filegroup(
    name = "GarageApp.xcassets",
    srcs = glob(["GarageApp.xcassets/**"]),
)

copy_to_directory(
    name = "postgres_output",
    srcs = [
        "//ext:pgvector",
        "//ext/postgres:postgres_rpath",
    ],
    out = "postgres",
    exclude_srcs_patterns = [
        "*/include/*",
    ],
    replace_prefixes = {
        "ext/postgres/postgres_rpath": "postgres/",
        "ext/pgvector/pgvector": "postgres/",
    },
)

swift_library(
    name = "GarageApp_lib",
    srcs = glob(["Sources/**/*.swift"]),
    data = [
        ":postgres_output",
        "//data/schema:config_schema",
        "//data/sql:sql_schema",
        "//garage_python:garage",
        "//garage_python:garage-mcp",
    ],
    module_name = "GarageApp",
    visibility = ["//visibility:private"],
)

macos_application(
    name = "GarageApp",
    app_icons = [":GarageApp.xcassets"],
    bundle_id = "dev.rickmark.garage",
    bundle_name = "Garage",
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    visibility = ["//visibility:public"],
    deps = [
        ":GarageApp_lib",
    ],
)

alias(
    name = "macapp",
    actual = ":GarageApp",
    visibility = ["//visibility:public"],
)
