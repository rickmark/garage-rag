load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_bazel_lib//lib:output_files.bzl", "output_files")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_apple//apple:xcarchive.bzl", "xcarchive")
load("@rules_swift//swift:swift.bzl", "swift_library")
load(
    "@rules_xcodeproj//xcodeproj:defs.bzl",
    "top_level_target",
    "xcodeproj",
)
load("//bazel:codesign.bzl", "codesign")
load("//bazel:notarytool.bzl", "notarytool")
load("//bazel:pkgbuild.bzl", "pkg_install", "pkgbuild")

filegroup(
    name = "GarageApp.xcassets",
    srcs = glob(["GarageApp.xcassets/**"]),
)

copy_to_directory(
    name = "postgres_raw",
    srcs = [
        "//ext:pgvector",
        "//ext/postgres:postgres_rpath",
    ],
    out = "postgres_raw",
    exclude_srcs_patterns = [
        "*/include/**/*",
    ],
    replace_prefixes = {
        "ext/pgvector/pgvector": "postgres/",
        "ext/postgres/postgres_rpath": "postgres/",
    },
)

codesign(
    name = "postgres_output",
    src = ":postgres_raw",
    out = "postgres",
    entitlements = select({
        "//bazel:is_store": ":Garage.entitlements",
        "//conditions:default": None,
    }),
    options = ["runtime"],
    signing_identity = select({
        "//bazel:is_adhoc": "-",
        "//bazel:is_store": "Apple Distribution: Richard Penwell (DWVXMLB45Y)",
        "//conditions:default": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
    }),
)

copy_to_directory(
    name = "schema_output",
    srcs = [
        "//data/sql:sql_schema",
    ],
    out = "schema",
    replace_prefixes = {
        "data/sql/sql": "schema/",
    },
)

codesign(
    name = "garage",
    src = "//garage_python:garage",
    entitlements = select({
        "//bazel:is_store": ":Garage.entitlements",
        "//conditions:default": None,
    }),
    options = ["runtime"],
    signing_identity = select({
        "//bazel:is_adhoc": "-",
        "//bazel:is_store": "Apple Distribution: Richard Penwell (DWVXMLB45Y)",
        "//conditions:default": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
    }),
)

codesign(
    name = "garage-mcp",
    src = "//garage_python:garage-mcp",
    entitlements = select({
        "//bazel:is_store": ":Garage.entitlements",
        "//conditions:default": None,
    }),
    options = ["runtime"],
    signing_identity = select({
        "//bazel:is_adhoc": "-",
        "//bazel:is_store": "Apple Distribution: Richard Penwell (DWVXMLB45Y)",
        "//conditions:default": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
    }),
)

swift_library(
    name = "GarageApp_lib",
    srcs = glob(["Sources/**/*.swift"]),
    data = [
        ":garage",
        ":garage-mcp",
        ":postgres_output",
        ":schema_output",
        "//data/schema:config_schema",
    ],
    module_name = "GarageApp",
    visibility = ["//visibility:private"],
)

macos_application(
    name = "GarageApp",
    app_icons = [":GarageApp.xcassets"],
    bundle_id = "me.rickmark.garage",
    bundle_name = "Garage",
    codesignopts = [
        "--options=runtime",  # This enables the Hardened Runtime flag
    ],
    entitlements = select({
        "//bazel:is_store": ":Garage.entitlements",
        "//conditions:default": None,
    }),
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    provisioning_profile = select({
        "//bazel:is_store": "GarageMacAppConnect.provisionprofile",
        "//conditions:default": None,
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":GarageApp_lib",
    ],
)

xcarchive(
    name = "Garage.xcarchive",
    bundle = ":GarageApp",
    visibility = ["//visibility:public"],
)

xcodeproj(
    name = "xcodeproj",
    project_name = "Garage",
    tags = ["manual"],
    top_level_targets = [
        top_level_target(
            ":GarageApp",
        ),
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "macapp",
    actual = ":GarageApp",
    visibility = ["//visibility:public"],
)

pkgbuild(
    name = "GarageInstaller",
    app = ":GarageApp",
    identifier = "me.rickmark.garage.pkg",
    install_location = "/Applications",
    signing_identity = "Developer ID Installer: Richard Penwell (DWVXMLB45Y)",
    visibility = ["//visibility:public"],
)

pkg_install(
    name = "install",
    pkg = ":GarageInstaller",
    visibility = ["//visibility:public"],
)

alias(
    name = "installer",
    actual = ":GarageInstaller",
    visibility = ["//visibility:public"],
)

alias(
    name = "xcarchive",
    actual = ":Garage.xcarchive",
)

alias(
    name = "GarageStore.xcarchive",
    actual = ":Garage.xcarchive",
    visibility = ["//visibility:public"],
)

notarytool(
    name = "GarageNotary",
    app = ":GarageApp",
    visibility = ["//visibility:public"],
)

alias(
    name = "notarytool",
    actual = ":GarageNotary",
    visibility = ["//visibility:public"],
)

alias(
    name = "notarize",
    actual = ":GarageNotary",
    visibility = ["//visibility:public"],
)

alias(
    name = "notary",
    actual = ":GarageNotary",
    visibility = ["//visibility:public"],
)
