load(
    "@rules_xcodeproj//xcodeproj:defs.bzl",
    "top_level_target",
    "xcodeproj",
)
load("//bazel:macos_application.bzl", "appstore_macos_application", "developer_id_macos_application")
load("//bazel:xcarchive.bzl", "appstore_xcarchive")

exports_files(
    glob(["*"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "GarageApp.xcassets",
    srcs = glob(["GarageApp.xcassets/**"]),
    visibility = ["//visibility:public"],
)

developer_id_macos_application(
    name = "Garage.app",
    app = "//macapp/Sources/GarageApp:GarageApp",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

appstore_macos_application(
    name = "GarageStore.app",
    app = "//macapp/Sources/GarageApp:GarageApp",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

appstore_xcarchive(
    name = "GarageStore.xcarchive",
    bundle = "//macapp/Sources/GarageApp:GarageApp",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

xcodeproj(
    name = "xcodeproj",
    project_name = "Garage",
    tags = ["manual"],
    top_level_targets = [
        top_level_target(
            "//macapp/Sources/GarageApp:GarageApp",
        ),
        top_level_target(
            "//macapp/Sources/LlamaXPCService:LlamaXPCService",
        ),
        top_level_target(
            "//macapp/Sources/GarageMCPServerService:GarageMCPServerService",
        ),
        top_level_target(
            "//macapp/Sources/GarageEmbedXPCService:GarageEmbedXPCService",
        ),
        top_level_target(
            "//macapp/Sources/GarageIngestXPCService:GarageIngestXPCService",
        ),
        top_level_target(
            "//macapp/Sources/GarageXPCService:GarageXPCService",
        ),
        top_level_target(
            "//macapp/Sources/ModelDownloadXPCService:ModelDownloadXPCService",
        ),
        top_level_target(
            "//macapp/Tests/GarageAppUnitTests:GarageAppUnitTests",
        ),
        top_level_target(
            "//macapp/Tests/GarageAppUITests:GarageAppUITests",
        ),
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "GarageApp",
    actual = "//macapp/Sources/GarageApp:GarageApp",
    visibility = ["//visibility:public"],
)

alias(
    name = "install",
    actual = "//macapp/package:install",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

alias(
    name = "garage",
    actual = "//macapp/Sources/GarageCLI:garage",
    visibility = ["//visibility:public"],
)

# Primary alias used by the build and tests to reference the main executable.
alias(
    name = "macapp",
    # The macOS application binary is produced by the developer_id_macos_application rule above.
    actual = ":GarageApp",
    visibility = ["//visibility:public"],
)

alias(
    name = "installer",
    actual = "//macapp/package:GarageInstaller",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

alias(
    name = "package",
    actual = "//macapp/package:package",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

alias(
    name = "xcarchive",
    actual = ":GarageStore.xcarchive",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
