filegroup(
    name = "GarageApp.xcassets",
    srcs = glob(["GarageApp.xcassets/**"]),
)

copy_to_directory(
    name = "postgres_raw",
    srcs = [
        "//ext:pgvector",
        "//ext/postgres:postgres_rpath",
    ],
    out = "postgres_raw",
    exclude_srcs_patterns = [
        "*/include/**/*",
    ],
    replace_prefixes = {
        "ext/pgvector/pgvector": "",
        "ext/postgres/postgres_rpath": "",
    },
)

codesign(
    name = "postgres_output",
    src = ":postgres_raw",
    out = "postgres",
    entitlements = select({
        "//bazel:is_store": ":GarageServer.entitlements",
        "//conditions:default": None,
    }),
    options = ["runtime"],
    parent_dir = "postgres",
    signing_identity = select({
        "//bazel:is_adhoc": "-",
        "//bazel:is_store": "Apple Distribution: Richard Penwell (DWVXMLB45Y)",
        "//conditions:default": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
    }),
)

copy_to_directory(
    name = "schema_output",
    srcs = [
        "//data/sql:sql_schema",
    ],
    out = "schema",
    replace_prefixes = {
        "data/sql/sql": "",
    },
)

swift_binary(
    name = "garage_bin",
    srcs = ["Sources/GarageCLI/main.swift"],
    linkopts = [
        "-Xlinker",
        "-rpath",
        "-Xlinker",
        "@executable_path/../Frameworks",
        "-Xlinker",
        "-rpath",
        "-Xlinker",
        "@loader_path/../Frameworks",
        "-Xlinker",
        "-rpath",
        "-Xlinker",
        "@executable_path/../Frameworks/Python.framework",
        "-Xlinker",
        "-rpath",
        "-Xlinker",
        "@loader_path/../Frameworks/Python.framework",
    ],
    deps = [
        "//ext/python:python_3_13_framework",
        "//ext/pythonkit:PythonKit_swift",
    ],
)

swift_binary(
    name = "garage_mcp_bin",
    srcs = ["Sources/GarageMCPCLI/main.swift"],
    linkopts = [
        "-Xlinker",
        "-rpath",
        "-Xlinker",
        "@executable_path/../Frameworks",
        "-Xlinker",
        "-rpath",
        "-Xlinker",
