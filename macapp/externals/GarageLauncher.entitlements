<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App Store entitlements for the `garage` and `garage-mcp` launchers (Contents/MacOS).

  Not com.apple.security.inherit: that only works in a child of an already sandboxed process, and
  these are started from Terminal or by an MCP client, never by GarageApp; with it they trap at
  launch. So each carries its own sandbox, with what it needs to reach the app's data: loopback
  Postgres (network.client), garage.json and the model catalog in the shared data folder (the
  team-prefixed app group, which needs no provisioning profile on macOS), and the same library
  validation exemption as the Python XPC services, for PythonXPCService.framework's interpreter
  and extension modules. A sandboxed tool also needs a bundle identifier of its own, so the store
  build embeds each launcher's Info.plist. The Postgres binaries the app starts keep
  GarageServer.entitlements.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>DWVXMLB45Y.group.me.rickmark.garage-rag</string>
	</array>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
