load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//bazel:codesign.bzl", "codesign")

exports_files(
    glob(["*"]),
    visibility = ["//visibility:public"],
)

alias(
    name = "postgres.conf",
    actual = ":postgresql.conf",
    visibility = ["//visibility:public"],
)

copy_to_directory(
    name = "postgres_raw",
    srcs = [
        ":postgresql.conf",
        "//ext:pgvector",
        "//ext/postgres:postgres_rpath",
    ],
    out = "postgres_raw",
    exclude_srcs_patterns = [
        "*/include/**/*",
    ],
    replace_prefixes = {
        "ext/pgvector/pgvector": "",
        "ext/postgres/postgres_rpath": "",
        "macapp/externals": "",
    },
)

codesign(
    name = "postgres_output",
    src = ":postgres_raw",
    out = "postgres",
    entitlements = select({
        "//bazel:is_store": "//macapp/externals:GarageServer.entitlements",
        "//conditions:default": "//macapp/externals:GarageServer.entitlements",
    }),
    options = ["runtime"],
    parent_dir = "postgres",
    signing_identity = select({
        "//bazel:is_adhoc": "-",
        "//bazel:is_store": "Apple Distribution: Richard Penwell (DWVXMLB45Y)",
        "//conditions:default": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
    }),
    visibility = ["//visibility:public"],
)

copy_to_directory(
    name = "schema_output",
    srcs = [
        "//data/sql:sql_schema",
    ],
    out = "schema",
    replace_prefixes = {
        "data/sql/sql": "",
    },
    visibility = ["//visibility:public"],
)
