load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//bazel:codesign.bzl", "codesign")
load("//bazel:signing.bzl", "STORE_IDENTITY")

exports_files(
    glob(["*"]),
    visibility = ["//visibility:public"],
)

alias(
    name = "postgres.conf",
    actual = ":postgresql.conf",
    visibility = ["//visibility:public"],
)

copy_to_directory(
    name = "postgres_raw",
    srcs = [
        ":postgresql.conf",
        "//ext:age",
        "//ext:pgvector",
        "//ext:postgres_rpath",
    ],
    out = "postgres_raw",
    exclude_srcs_patterns = [
        "*/include/**/*",
    ],
    replace_prefixes = {
        "ext/age/age": "",
        "ext/pgvector/pgvector": "",
        "ext/postgres/postgres_rpath": "",
        "ext/postgres19/postgres_rpath": "",
        "macapp/externals": "",
    },
)

codesign(
    name = "postgres_output",
    src = ":postgres_raw",
    out = "postgres",
    entitlements = select({
        "//bazel:is_store": "//macapp/externals:GarageServer.entitlements",
        "//conditions:default": None,
    }),
    options = ["runtime"],
    parent_dir = "postgres",
    signing_identity = select({
        "//bazel:is_developer_id": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
        "//bazel:is_store": STORE_IDENTITY,
        "//conditions:default": "-",
    }),
    visibility = ["//visibility:public"],
)

# libtesseract, shipped inside PythonXPCService.framework (see python_framework_libs) and used
# by garage_rag.extract.tesseract through ctypes. Like libpq it must carry the app's Team ID
# for library validation. Named for its install name (@rpath/libtesseract.5.5.dylib), which is
# what the framework's load command asks dyld for.
codesign(
    name = "libtesseract",
    src = "//ext/tesseract",
    out = "libtesseract.5.5.dylib",
    options = ["runtime"],
    signing_identity = select({
        "//bazel:is_developer_id": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
        "//bazel:is_store": STORE_IDENTITY,
        "//conditions:default": "-",
    }),
    visibility = ["//visibility:public"],
)

# `PythonXPCService.framework/tessdata/eng.traineddata`, next to the framework's `Frameworks`
# folder, where garage_rag.extract.tesseract looks for it.
copy_to_directory(
    name = "tessdata_output",
    srcs = ["//ext/tesseract:tessdata"],
    out = "tessdata",
    include_external_repositories = ["+http_file+tessdata_eng"],
    root_paths = ["file"],
    visibility = ["//visibility:public"],
)

# PostgreSQL client library, shipped inside PythonXPCService.framework (see
# python_framework_libs). psycopg's pure Python implementation uses it through ctypes; it must
# carry the app's Team ID (hardened runtime / library validation rejects the Homebrew copy) and
# the runtime option.
codesign(
    name = "libpq",
    src = "//ext:libpq_dylib",
    out = "libpq.dylib",
    options = ["runtime"],
    signing_identity = select({
        "//bazel:is_developer_id": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
        "//bazel:is_store": STORE_IDENTITY,
        "//conditions:default": "-",
    }),
    visibility = ["//visibility:public"],
)

# `PythonXPCService.framework/Frameworks/`: the libraries the framework links with load
# commands (`@rpath`, resolved through its `@loader_path/Frameworks` rpath). dyld loads them
# when a service or launcher starts, before the App Sandbox applies, and Python finds them among
# the process's loaded images; nothing locates them by path.
copy_to_directory(
    name = "python_framework_libs",
    srcs = [
        ":libpq",
        ":libtesseract",
    ],
    out = "Frameworks",
    root_paths = ["macapp/externals"],
    visibility = ["//visibility:public"],
)

copy_to_directory(
    name = "schema_output",
    srcs = [
        "//data/sql:sql_schema",
    ],
    out = "schema",
    replace_prefixes = {
        "data/sql/sql": "",
    },
    visibility = ["//visibility:public"],
)

copy_to_directory(
    name = "site-python-only",
    srcs = [
        "//ext/python:python_3_13",
    ],
    exclude_srcs_patterns = [
        "**/test/**",
        "**/test",
        # Build-time only (Makefile, libpython3.13.a, python.o): never loaded by the embedded
        # interpreter, and the static library alone is dead weight in the bundle.
        "**/config-3.13-darwin/**",
        "**/config-3.13-darwin",
    ],
    # The real version directory, not Versions/Current: whether that symlink is walked depends on
    # the configuration (the rules_xcodeproj build does not), and when it is not, nothing matches
    # and site-python ships without the standard library.
    include_srcs_patterns = [
        "ext/python/python_3_13/Python.framework/Versions/3.13/lib/python3.13/**",
    ],
    replace_prefixes = {
        "ext/python/python_3_13/Python.framework/Versions/3.13/lib/python3.13": "",
    },
)

copy_to_directory(
    name = "site-python-raw",
    srcs = [
        ":site-python-only",
        "//garage_python:site-packages",
    ],
    out = "site-python-raw",
    replace_prefixes = {
        "garage_python/site-packages": "site-packages",
        "site-python-only": "",
    },
    visibility = ["//visibility:public"],
)

codesign(
    name = "site-python",
    src = ":site-python-raw",
    out = "site-python",
    options = ["runtime"],
    signing_identity = select({
        "//bazel:is_developer_id": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
        "//bazel:is_store": STORE_IDENTITY,
        "//conditions:default": "-",
    }),
    visibility = ["//visibility:public"],
)
