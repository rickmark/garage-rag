load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//bazel:codesign.bzl", "codesign")
load("//bazel:signing.bzl", "STORE_IDENTITY")

exports_files(
    glob(["*"]),
    visibility = ["//visibility:public"],
)

alias(
    name = "postgres.conf",
    actual = ":postgresql.conf",
    visibility = ["//visibility:public"],
)

copy_to_directory(
    name = "postgres_raw",
    srcs = [
        ":postgresql.conf",
        "//ext:pgvector",
        "//ext:postgres_rpath",
    ],
    out = "postgres_raw",
    exclude_srcs_patterns = [
        "*/include/**/*",
    ],
    replace_prefixes = {
        "ext/pgvector/pgvector": "",
        "ext/postgres/postgres_rpath": "",
        "ext/postgres19/postgres_rpath": "",
        "macapp/externals": "",
    },
)

codesign(
    name = "postgres_output",
    src = ":postgres_raw",
    out = "postgres",
    entitlements = select({
        "//bazel:is_store": "//macapp/externals:GarageServer.entitlements",
        "//conditions:default": None,
    }),
    options = ["runtime"],
    parent_dir = "postgres",
    signing_identity = select({
        "//bazel:is_developer_id": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
        "//bazel:is_store": STORE_IDENTITY,
        "//conditions:default": "-",
    }),
    visibility = ["//visibility:public"],
)

# PostgreSQL client library shipped as `Contents/Frameworks/libpq.dylib`. psycopg's pure
# Python implementation loads it through ctypes; it must carry the app's Team ID
# (hardened runtime / library validation rejects the Homebrew copy) and the runtime option.
codesign(
    name = "libpq",
    src = "//ext:libpq_dylib",
    out = "libpq.dylib",
    options = ["runtime"],
    signing_identity = select({
        "//bazel:is_developer_id": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
        "//bazel:is_store": STORE_IDENTITY,
        "//conditions:default": "-",
    }),
    visibility = ["//visibility:public"],
)

copy_to_directory(
    name = "schema_output",
    srcs = [
        "//data/sql:sql_schema",
    ],
    out = "schema",
    replace_prefixes = {
        "data/sql/sql": "",
    },
    visibility = ["//visibility:public"],
)

copy_to_directory(
    name = "site-python-only",
    srcs = [
        "//ext/python:python_3_13",
    ],
    exclude_srcs_patterns = [
        "**/test/**",
        "**/test",
        # Build-time only (Makefile, libpython3.13.a, python.o): never loaded by the embedded
        # interpreter, and the static library alone is dead weight in the bundle.
        "**/config-3.13-darwin/**",
        "**/config-3.13-darwin",
    ],
    include_srcs_patterns = [
        "ext/python/python_3_13/Python.framework/Versions/Current/lib/python3.13/**",
    ],
    replace_prefixes = {
        "ext/python/python_3_13/Python.framework/Versions/Current/lib/python3.13": "",
    },
)

copy_to_directory(
    name = "site-python-raw",
    srcs = [
        ":site-python-only",
        "//garage_python:site-packages",
    ],
    out = "site-python-raw",
    replace_prefixes = {
        "garage_python/site-packages": "site-packages",
        "site-python-only": "",
    },
    visibility = ["//visibility:public"],
)

codesign(
    name = "site-python",
    src = ":site-python-raw",
    out = "site-python",
    options = ["runtime"],
    signing_identity = select({
        "//bazel:is_developer_id": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
        "//bazel:is_store": STORE_IDENTITY,
        "//conditions:default": "-",
    }),
    visibility = ["//visibility:public"],
)
