load("@rules_apple//apple:macos.bzl", "macos_xpc_service")
load("@rules_swift//swift:swift.bzl", "swift_library")

# Implementation library for GarageMCPServerService
swift_library(
    name = "GarageMCPServerService_lib",
    srcs = glob(["**/*.swift"]),
    module_name = "GarageMCPServerService",
    visibility = ["//visibility:private"],
    deps = [
        "//macapp/Sources/PythonXPCService",
    ],
)

# The actual XPC service binary
macos_xpc_service(
    name = "GarageMCPServerService",
    bundle_id = "me.rickmark.garage-rag.mcp-server-xpc",
    bundle_name = "GarageMCPServerService",
    codesignopts = [
        "--options=runtime",
    ],
    entitlements = ":GarageMCPServerService.entitlements",
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    version = "//macapp/Sources/GarageApp:GarageAppVersion",
    visibility = ["//visibility:public"],
    deps = [
        ":GarageMCPServerService_lib",
    ],
)
