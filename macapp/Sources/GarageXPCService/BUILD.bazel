load("@rules_apple//apple:macos.bzl", "macos_xpc_service")
load("@rules_swift//swift:swift.bzl", "swift_library")

# Implementation library for GarageXPCService
swift_library(
    name = "GarageXPCService_lib",
    srcs = [
        "main.swift",
    ],
    module_name = "GarageXPCService",
    visibility = ["//visibility:private"],
    deps = [
        "//macapp/Sources/PythonXPCService",
    ],
)

# The actual XPC service binary
macos_xpc_service(
    name = "GarageXPCService",
    bundle_id = "me.rickmark.garage-rag.xpc",
    bundle_name = "GarageXPCService",
    codesignopts = [
        "--options=runtime",
    ],
    entitlements = ":GarageXPCService.entitlements",
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    version = "//macapp/Sources/GarageApp:GarageAppVersion",
    visibility = ["//visibility:public"],
    deps = [
        ":GarageXPCService_lib",
    ],
)
