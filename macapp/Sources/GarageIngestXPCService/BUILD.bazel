load("@rules_apple//apple:macos.bzl", "macos_xpc_service")
load("@rules_swift//swift:swift.bzl", "swift_library")

# Implementation library for GarageIngestXPCService
swift_library(
    name = "GarageIngestXPCService_lib",
    srcs = glob(["**/*.swift"]),
    module_name = "GarageIngestXPCService",
    visibility = ["//visibility:private"],
    deps = [
        "//macapp/Sources/IngestClient:IngestClient_lib",
        "//macapp/Sources/PythonXPCService:PythonXPCService_static",
    ],
)

# The actual XPC service binary
macos_xpc_service(
    name = "GarageIngestXPCService",
    bundle_id = "me.rickmark.garage-rag.ingest-xpc",
    bundle_name = "GarageIngestXPCService",
    codesignopts = [
        "--options=runtime",
    ],
    entitlements = ":GarageIngestXPCService.entitlements",
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    version = "//macapp/Sources/GarageApp:GarageAppVersion",
    visibility = ["//visibility:public"],
    deps = [
        ":GarageIngestXPCService_lib",
        "//ext/python:python_3_13_static",
    ],
)
