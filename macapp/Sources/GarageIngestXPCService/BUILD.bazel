load("@rules_apple//apple:macos.bzl", "macos_xpc_service")
load("@rules_swift//swift:swift.bzl", "swift_library")

# Implementation library for GarageIngestXPCService
swift_library(
    name = "GarageIngestXPCService_lib",
    srcs = glob(["**/*.swift"]),
    module_name = "GarageIngestXPCService",
    visibility = ["//visibility:private"],
    deps = [
        "//macapp/Sources/IngestClient",
        "//macapp/Sources/PythonXPCService",
    ],
)

# The actual XPC service binary
macos_xpc_service(
    name = "GarageIngestXPCService",
    additional_linker_inputs = [
        "//macapp/externals:libpq",
        "//ext/python:python_framework",
        "//ext/pythonkit:PythonKit",
        "//macapp/Sources/PythonXPCService:PythonXPCService_signed",
    ],
    bundle_id = "me.rickmark.garage-rag.ingest-xpc",
    bundle_name = "GarageIngestXPCService",
    entitlements = select({
        "//bazel:is_store": ":GarageIngestXPCService.entitlements",
        "//bazel:is_developer_id": "//macapp/externals:GarageAppGroup.entitlements",
        "//conditions:default": None,
    }),
    infoplists = ["Info.plist"],
    linkopts = [
        # Load libpq at launch, before the App Sandbox applies: a later dlopen of it by path is
        # otherwise blocked in the sandboxed (App Store) build.
        "-needed_library",
        "$(location //macapp/externals:libpq)",
        "-F$(location //ext/python:python_framework)/..",
        "-framework",
        "Python",
        "-F$(location //macapp/Sources/PythonXPCService:PythonXPCService_signed)/..",
        "-framework",
        "PythonXPCService",
    ],
    minimum_os_version = "14.0",
    version = "//macapp/Sources/GarageApp:GarageAppVersion",
    visibility = ["//visibility:public"],
    deps = [
        ":GarageIngestXPCService_lib",
    ],
)
