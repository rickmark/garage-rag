<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Developer ID entitlements for Garage.app (not sandboxed). The application identifier and team
  identifier, backed by the embedded Developer ID profile (macapp/GarageRAGDeveloperID.provisionprofile),
  are what let the app use the data-protection keychain; the App Group is both the shared data
  folder's container and the access group of the Postgres password item, which the garage /
  garage-mcp helper bundles read without a prompt. Every entry here must be within what that
  profile authorizes (it allows DWVXMLB45Y.* for the app groups and keychain access groups).
-->
<plist version="1.0">
<dict>
	<key>com.apple.application-identifier</key>
	<string>DWVXMLB45Y.me.rickmark.garage-rag</string>
	<key>com.apple.developer.team-identifier</key>
	<string>DWVXMLB45Y</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>DWVXMLB45Y.group.me.rickmark.garage-rag</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>DWVXMLB45Y.group.me.rickmark.garage-rag</string>
	</array>
</dict>
</plist>
