load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//bazel:codesign.bzl", "HARDENED_RUNTIME_CODESIGNOPTS")
load("//bazel:version.bzl", "macapp_version")

# publish_appcast checks the release key against SUPublicEDKey; test_appcast checks the feed URL.
exports_files(
    ["Sparkle.plist"],
    visibility = [
        "//garage_python/tests:__pkg__",
        "//macapp/package:__pkg__",
    ],
)

swift_library(
    name = "GarageApp_lib",
    srcs = glob(["**/*.swift"]),
    # rules_apple already gives the app and its test bundles @executable_path/../Frameworks
    # and @loader_path/../Frameworks (repeating them made ld warn "duplicate -rpath");
    # only the Python.framework directories are added here.
    linkopts = [
        "-Xlinker",
        "-rpath",
        "-Xlinker",
        "@executable_path/../Frameworks/Python.framework",
        "-Xlinker",
        "-rpath",
        "-Xlinker",
        "@loader_path/../Frameworks/Python.framework",
    ],
    module_name = "GarageApp",
    visibility = ["//visibility:public"],
    deps = [
        "//macapp/Sources/GarageUpdater",
        "//macapp/Sources/IngestClient",
        "//macapp/Sources/LlamaClient",
        "//macapp/Sources/MCPServerClient",
        "//macapp/Sources/ModelDownloadClient",
        "//macapp/Sources/PythonXPCService",
        "//proto:garage_proto_swift",
    ],
)

macapp_version(
    name = "GarageAppVersion",
    short_version_string = "1.5",
    visibility = ["//visibility:public"],
)

macos_application(
    name = "GarageApp",
    additional_contents = {
        "//macapp/Sources/GarageCLI:garage": "MacOS",
        "//macapp/Sources/GarageMCPCLI:garage-mcp": "MacOS",
        "//macapp/externals:postgres_output": "Resources/postgres",
        "//macapp/externals:schema_output": "Resources/schema",
        "//macapp/externals:postgresql.conf": "Resources",
        "//docs:model_manifest": "Resources",
        "//docs:config_schema": "Resources",
        "//data/notices:third_party_notices": "Resources",
        "//garage_python:LICENSE": "Resources",
    },
    app_icons = ["//macapp:GarageApp.xcassets"],
    bundle_id = "me.rickmark.garage-rag",
    bundle_name = "Garage",
    codesignopts = HARDENED_RUNTIME_CODESIGNOPTS,
    entitlements = select({
        "//bazel:is_store": ":Garage.entitlements",
        "//bazel:is_developer_id": "//macapp/externals:GarageAppGroup.entitlements",
        "//conditions:default": None,
    }),
    executable_name = "GarageApp",
    frameworks = [
        "//macapp/Sources/PythonXPCService:PythonXPCService_framework",
    ],
    # Sparkle's SUFeedURL/SUPublicEDKey only belong in the builds that embed
    # Sparkle. The App Store build updates through the App Store.
    infoplists = [":Info.plist"] + select({
        "//bazel:is_store": [],
        "//conditions:default": [":Sparkle.plist"],
    }),
    minimum_os_version = "14.0",
    # Store builds sign with Apple Development and this development profile, so they run on
    # registered Macs; Xcode re-signs with Apple Distribution (GarageMacAppConnect) on upload.
    provisioning_profile = select({
        "//bazel:is_store": "//macapp:GarageRAGDevelopmentApp.provisionprofile",
        "//conditions:default": None,
    }),
    version = ":GarageAppVersion",
    visibility = ["//visibility:public"],
    xpc_services = [
        "//macapp/Sources/LlamaXPCService:LlamaXPCService",
        "//macapp/Sources/GarageMCPServerService:GarageMCPServerService",
        "//macapp/Sources/GarageEmbedXPCService:GarageEmbedXPCService",
        "//macapp/Sources/GarageIngestXPCService:GarageIngestXPCService",
        "//macapp/Sources/GarageXPCService:GarageXPCService",
        "//macapp/Sources/ModelDownloadXPCService:ModelDownloadXPCService",
    ],
    deps = [
        ":GarageApp_lib",
        "//ext/python:python_framework",
    ],
)
