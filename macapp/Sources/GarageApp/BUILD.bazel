load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//bazel:garage_app.bzl", "garage_macos_application")
load("//bazel:launcher_app.bzl", "bundle_archive")
load("//bazel:version.bzl", "macapp_version")

# publish_appcast checks the release key against SUPublicEDKey; test_appcast checks the feed URL.
# The model UI tests' host app (//bazel:garage_app.bzl, like GarageApp) bundles it too.
exports_files(
    ["Sparkle.plist"],
    visibility = [
        "//garage_python/tests:__pkg__",
        "//macapp/Tests/GarageAppModelUITests:__pkg__",
        "//macapp/package:__pkg__",
    ],
)

# The rest of what garage_macos_application bundles from here, for the model UI tests' host app,
# which lives in its own package: two apps named Garage in one package would write the same
# Garage.app output.
exports_files(
    [
        "Garage.entitlements",
        "GarageDeveloperID.entitlements",
        "Info.plist",
        "PrivacyInfo.xcprivacy",
        "link_launchers.sh",
    ],
    visibility = ["//macapp/Tests/GarageAppModelUITests:__pkg__"],
)

swift_library(
    name = "GarageApp_lib",
    srcs = glob(["**/*.swift"]),
    # rules_apple already gives the app and its test bundles @executable_path/../Frameworks
    # and @loader_path/../Frameworks (repeating them made ld warn "duplicate -rpath");
    # only the Python.framework directories are added here.
    linkopts = [
        "-Xlinker",
        "-rpath",
        "-Xlinker",
        "@executable_path/../Frameworks/Python.framework",
        "-Xlinker",
        "-rpath",
        "-Xlinker",
        "@loader_path/../Frameworks/Python.framework",
    ],
    module_name = "GarageApp",
    visibility = ["//visibility:public"],
    deps = [
        "//macapp/Sources/GarageUpdater",
        "//macapp/Sources/IngestClient",
        "//macapp/Sources/LlamaClient",
        "//macapp/Sources/LlamaModelLoader",
        "//macapp/Sources/MCPServerClient",
        "//macapp/Sources/ModelDownloadClient",
        "//macapp/Sources/PythonXPCService",
        "//proto:garage_proto_swift",
    ],
)

macapp_version(
    name = "GarageAppVersion",
    short_version_string = "1.5",
    visibility = ["//visibility:public"],
)

# The app bundle (//bazel:garage_app.bzl), with the real llama.cpp service.
garage_macos_application(
    name = "GarageApp",
    llama_xpc_service = "//macapp/Sources/LlamaXPCService:LlamaXPCService",
    visibility = ["//visibility:public"],
)

# The bundle's launcher layout: the forwarders in Contents/MacOS, the helper bundles in
# Contents/Helpers with their identifiers, and `garage version` run through the forwarder.
# gazelle:exclude bundle_layout_test.sh
# gazelle:exclude link_launchers.sh
bundle_archive(
    name = "GarageApp_archive",
    app = ":GarageApp",
)

sh_test(
    name = "bundle_layout_test",
    size = "medium",
    srcs = ["bundle_layout_test.sh"],
    args = ["$(rootpath :GarageApp_archive)"],
    data = [":GarageApp_archive"],
)
