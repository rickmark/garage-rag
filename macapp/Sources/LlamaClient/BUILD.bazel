load("@rules_swift//swift:swift.bzl", "swift_library")

# LlamaClient: the Llama XPC protocol, its Swift client and the in-process llama.cpp server engine.
# The @objc protocol lives in the same module as the client so it is registered once.
swift_library(
    name = "LlamaClient",
    srcs = glob(["**/*.swift"]),
    module_name = "LlamaClient",
    visibility = ["//visibility:public"],
    deps = [
        "//macapp/Sources/PythonXPCService",
    ],
)
