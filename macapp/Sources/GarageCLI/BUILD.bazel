load("//bazel:launcher_app.bzl", "garage_launcher_app")

# `garage`, as the helper bundle Garage.app/Contents/Helpers/garage.app. The file `garage` next to
# this BUILD file is the forwarder that becomes Garage.app/Contents/MacOS/garage.
exports_files(
    ["garage"],
    visibility = ["//macapp:__subpackages__"],
)

garage_launcher_app(
    name = "garage_app",
    bundle_id = "me.rickmark.garage-rag.garage-cli",
    bundle_name = "garage",
    developer_id_entitlements = ":GarageCLI.developer_id.entitlements",
    developer_id_profile = "//macapp:GarageRAGDevIDCLI.provisionprofile",
    main = "main.swift",
    store_entitlements = ":GarageCLI.entitlements",
    store_profile = "//macapp:GarageRAGDevelopmentCLI.provisionprofile",
    visibility = ["//visibility:public"],
)
