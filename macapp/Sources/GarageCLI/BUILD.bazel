load("@rules_swift//swift:swift.bzl", "swift_binary")
load("//bazel:codesign.bzl", "codesign")

swift_binary(
    name = "garage_bin",
    srcs = ["main.swift"],
    additional_linker_inputs = [
        "//ext/python:python_framework",
    ],
    linkopts = [
        # Link the bundled Python.framework directly (PyConfig embedding API); resolved at runtime via the
        # @executable_path/../Frameworks rpath below.
        "-F$(location //ext/python:python_framework)/..",
        "-framework",
        "Python",
        "-Xlinker",
        "-rpath",
        "-Xlinker",
        "@executable_path/../Frameworks",
        "-Xlinker",
        "-rpath",
        "-Xlinker",
        "@loader_path/../Frameworks",
        "-Xlinker",
        "-rpath",
        "-Xlinker",
        "@executable_path/../Frameworks/Python.framework",
        "-Xlinker",
        "-rpath",
        "-Xlinker",
        "@loader_path/../Frameworks/Python.framework",
    ],
    deps = [
        "//ext/python:python_3_13_framework",
        "//ext/pythonkit:PythonKit_swift",
        # Shared PyConfig-based interpreter start-up (isolated home / sys.path from Resources/site-python).
        # Linked statically; the CLI does not load PythonXPCService.framework at runtime.
        "//macapp/Sources/PythonXPCService:PythonXPCService_swift",
    ],
)

codesign(
    name = "garage",
    src = ":garage_bin",
    entitlements = select({
        "//bazel:is_store": "//macapp/externals:GarageServer.entitlements",
        "//conditions:default": None,
    }),
    options = ["runtime"],
    signing_identity = select({
        "//bazel:is_adhoc": "-",
        "//bazel:is_store": "Apple Distribution: Richard Penwell (DWVXMLB45Y)",
        "//conditions:default": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
    }),
    visibility = ["//visibility:public"],
)
