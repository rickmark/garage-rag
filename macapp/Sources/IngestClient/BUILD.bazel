load("@rules_swift//swift:swift.bzl", "swift_library")

# IngestClient: the ingest/embed/core-backend XPC protocols, their Swift clients and shared models.
# The @objc protocols live in the same module as the clients so each protocol is registered once.
swift_library(
    name = "IngestClient",
    srcs = glob(["**/*.swift"]),
    module_name = "IngestClient",
    visibility = ["//visibility:public"],
    deps = [
        "//macapp/Sources/PythonXPCService",
    ],
)
