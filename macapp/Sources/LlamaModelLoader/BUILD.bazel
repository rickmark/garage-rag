load("@rules_swift//swift:swift.bzl", "swift_library")

# LlamaModelLoader: loads llama_xpc models on demand over NSXPC (LlamaXPCService `ensureModel`).
# Resolves a model's slug to its downloaded GGUF and load settings (shared with the Models page),
# deduplicates concurrent loads, and hands the embedded Python a C entry point to call through ctypes.
swift_library(
    name = "LlamaModelLoader",
    srcs = glob(["**/*.swift"]),
    module_name = "LlamaModelLoader",
    visibility = ["//visibility:public"],
    deps = [
        "//macapp/Sources/LlamaClient",
        "//macapp/Sources/ModelDownloadClient",
        "//macapp/Sources/PythonXPCService",
    ],
)
