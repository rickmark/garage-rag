load("@rules_apple//apple:macos.bzl", "macos_framework")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//bazel:codesign.bzl", "codesign")

# Protocol definitions for all XPC services
swift_library(
    name = "PythonXPCService_protocol",
    srcs = [
        "GarageCommonXPCProtocol.swift",
    ],
    module_name = "PythonXPCService_protocol",
    visibility = ["//visibility:public"],
    deps = [
        "//ext:PythonKit",
    ],
)

swift_library(
    name = "PythonXPCService_swift",
    srcs = [
        "GarageFileLogger.swift",
        "GarageGRPCOverXPC.swift",
        "GarageXPCOutputCapture.swift",
        "XPCSitePathSetup.swift",
        "_Reexport.swift",
    ],
    module_name = "PythonXPCService",
    visibility = ["//visibility:public"],
    deps = [
        ":PythonXPCService_protocol",
        "//ext:PythonKit",
        "//ext:openssl",  # For libssl.a and libcrypto.a
        "//ext/postgres:libpq",  # For static libpq.a
    ],
)

alias(
    name = "PythonXPCService",
    actual = ":PythonXPCService_swift",
    visibility = ["//visibility:public"],
)

macos_framework(
    name = "PythonXPCService_framework",
    additional_linker_inputs = [
        "//ext/python:python_framework",
    ],
    bundle_id = "me.rickmark.garage-rag.PythonXPCService",
    bundle_name = "PythonXPCService",
    infoplists = ["Info.plist"],
    linkopts = [
        "-F$(location //ext/python:python_framework)/..",
        "-framework",
        "Python",
    ],
    minimum_os_version = "14.0",
    version = "//macapp/Sources/GarageApp:GarageAppVersion",
    visibility = ["//visibility:public"],
    deps = [
        ":PythonXPCService_swift",
    ],
)

codesign(
    name = "PythonXPCService_signed",
    src = ":PythonXPCService_framework",
    out = "PythonXPCService.framework",
    is_framework = True,
    signing_identity = select({
        "//bazel:is_adhoc": "-",
        "//bazel:is_store": "Apple Distribution: Richard Penwell (DWVXMLB45Y)",
        "//conditions:default": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
    }),
    visibility = ["//visibility:public"],
)
