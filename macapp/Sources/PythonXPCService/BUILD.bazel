load("@rules_swift//swift:swift.bzl", "swift_library")

# Protocol definitions for all XPC services
swift_library(
    name = "PythonXPCService_protocol",
    srcs = [
        "GarageCommonXPCProtocol.swift",
    ],
    module_name = "PythonXPCService_protocol",
    visibility = ["//visibility:public"],
    deps = [
        "//ext:PythonKit",
    ],
)

# Shared implementation utilities (output capture, site-path setup)
swift_library(
    name = "PythonXPCService_lib",
    srcs = [
        "GarageFileLogger.swift",
        "GarageGRPCOverXPC.swift",
        "GarageXPCOutputCapture.swift",
        "XPCSitePathSetup.swift",
        "_Reexport.swift",
    ],
    module_name = "PythonXPCService_lib",
    visibility = ["//visibility:public"],
    deps = [
        ":PythonXPCService_protocol",
        "//ext:PythonKit",
    ],
)

# Statically linked XPC service library with Python, PythonKit, and OpenSSL
swift_library(
    name = "PythonXPCService_static",
    srcs = [
        "GarageFileLogger.swift",
        "GarageGRPCOverXPC.swift",
        "GarageXPCOutputCapture.swift",
        "XPCSitePathSetup.swift",
        "_Reexport.swift",
    ],
    module_name = "PythonXPCService_static",
    visibility = ["//visibility:public"],
    deps = [
        ":PythonXPCService_protocol",
        "//ext:PythonKit",
        "//ext:openssl",  # For libssl.a and libcrypto.a
        "//ext/postgres:libpq",  # For static libpq.a
    ],
)
