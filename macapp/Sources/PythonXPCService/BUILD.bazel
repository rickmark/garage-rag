load("@rules_apple//apple:macos.bzl", "macos_framework")
load("@rules_apple//apple:resources.bzl", "apple_resource_group")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_swift//swift:swift.bzl", "swift_binary", "swift_library")
load("//bazel:codesign.bzl", "codesign")
load("//bazel:signing.bzl", "STORE_IDENTITY")

# Protocol definitions for all XPC services
swift_library(
    name = "PythonXPCService_protocol",
    srcs = [
        "GarageAppGroup.swift",
        "GarageCommonXPCProtocol.swift",
        "GaragePostgresEndpoint.swift",
        "GarageSockets.swift",
    ],
    module_name = "PythonXPCService_protocol",
    visibility = ["//visibility:public"],
)

# C shim around the CPython PyConfig embedding API (isolated interpreter start-up).
# Headers come from the framework build; the interpreter itself is provided by the
# bundled Python.framework that every consumer links with `-framework Python`.
objc_library(
    name = "GaragePythonEmbed",
    srcs = ["CPythonEmbed/GaragePythonEmbed.c"],
    hdrs = ["CPythonEmbed/GaragePythonEmbed.h"],
    includes = ["CPythonEmbed"],
    module_name = "GaragePythonEmbed",
    visibility = ["//visibility:public"],
    deps = [
        "//ext/python:python_headers",
    ],
)

swift_library(
    name = "PythonXPCService_swift",
    srcs = [
        "GarageFileLogger.swift",
        "GaragePythonRuntime.swift",
        "GarageXPCCrashHandler.swift",
        "GarageXPCOutputCapture.swift",
        "GarageXPCPeerRequirement.swift",
        "GarageXPCSelfTests.swift",
        "GarageXPCServiceBase.swift",
        "GarageXPCServiceHost.swift",
        "UTF8StreamDecoder.swift",
        "XPCSitePathSetup.swift",
        "_Reexport.swift",
    ],
    module_name = "PythonXPCService",
    visibility = ["//visibility:public"],
    deps = [
        ":GaragePythonEmbed",
        ":PythonXPCService_protocol",
        "//ext:PythonKit",
    ],
)

alias(
    name = "PythonXPCService",
    actual = ":PythonXPCService_swift",
    visibility = ["//visibility:public"],
)

# Command line smoke test: `bazel run //macapp/Sources/PythonXPCService:python_embed_smoke` starts the isolated
# interpreter exactly like the XPC services do, from the framework it links, and runs the standard self tests.
swift_binary(
    name = "python_embed_smoke",
    srcs = ["SmokeTest/main.swift"],
    additional_linker_inputs = [
        "//ext/python:python_framework",
        ":PythonXPCService_signed",
    ],
    linkopts = [
        "-F$(location //ext/python:python_framework)/..",
        "-framework",
        "Python",
        "-Xlinker",
        "-rpath",
        "-Xlinker",
        "$(location //ext/python:python_framework)/..",
        "-F$(location :PythonXPCService_signed)/..",
        "-framework",
        "PythonXPCService",
        "-Xlinker",
        "-rpath",
        "-Xlinker",
        "$(location :PythonXPCService_signed)/..",
    ],
    tags = ["manual"],
    deps = [
        ":PythonXPCService_swift",
    ],
)

# The embedded interpreter's home (stdlib, lib-dynload, site-packages) lives in this framework's
# resources. Sandboxed XPC services may read inside the frameworks they link, but not elsewhere in
# the app bundle, so this is the one place the App Store build's Python services can load it from.
# `openssl.cnf`, next to `site-python`, is the empty OpenSSL configuration GaragePythonRuntime
# exports as OPENSSL_CONF.
apple_resource_group(
    name = "site_python_resources",
    resources = ["openssl.cnf"],
    structured_resources = [
        "//macapp/externals:python_framework_libs",
        "//macapp/externals:site-python",
        "//macapp/externals:tessdata_output",
    ],
)

macos_framework(
    name = "PythonXPCService_framework",
    additional_linker_inputs = [
        "//ext/python:python_framework",
        "//macapp/externals:libpq",
        "//macapp/externals:libtesseract",
    ],
    bundle_id = "me.rickmark.garage-rag.PythonXPCService",
    bundle_name = "PythonXPCService",
    infoplists = ["Info.plist"],
    linkopts = [
        "-F$(location //ext/python:python_framework)/..",
        "-framework",
        "Python",
        "-framework",
        "SystemConfiguration",
        # libpq and libtesseract ship in this framework's Frameworks folder and load with it, so
        # every process that links the framework has them. Nothing here calls them (Python does,
        # through ctypes), so -needed_library keeps the load commands the linker would drop.
        "-needed_library",
        "$(location //macapp/externals:libpq)",
        "-needed_library",
        "$(location //macapp/externals:libtesseract)",
        "-rpath",
        "@loader_path/Frameworks",
    ],
    minimum_os_version = "14.0",
    resources = [":site_python_resources"],
    version = "//macapp/Sources/GarageApp:GarageAppVersion",
    visibility = ["//visibility:public"],
    deps = [
        ":PythonXPCService_swift",
    ],
)

codesign(
    name = "PythonXPCService_signed",
    src = ":PythonXPCService_framework",
    out = "PythonXPCService.framework",
    is_framework = True,
    signing_identity = select({
        "//bazel:is_developer_id": "Developer ID Application: Richard Penwell (DWVXMLB45Y)",
        "//bazel:is_store": STORE_IDENTITY,
        "//conditions:default": "-",
    }),
    visibility = ["//visibility:public"],
)
