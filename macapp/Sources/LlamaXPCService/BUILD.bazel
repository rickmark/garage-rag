load("@rules_apple//apple:macos.bzl", "macos_xpc_service")
load("@rules_swift//swift:swift.bzl", "swift_library")

swift_library(
    name = "LlamaXPCService_lib",
    srcs = glob(["**/*.swift"]),
    module_name = "LlamaXPCService",
    visibility = ["//visibility:private"],
    deps = [
        "//macapp:LlamaClient_lib",
    ],
)

macos_xpc_service(
    name = "LlamaXPCService",
    bundle_id = "me.rickmark.garage.llama-xpc",
    bundle_name = "LlamaXPCService",
    codesignopts = [
        "--options=runtime",
    ],
    entitlements = select({
        "//bazel:is_store": ":LlamaXPCService.entitlements",
        "//conditions:default": None,
    }),
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    version = "//macapp:GarageAppVersion",
    visibility = ["//visibility:public"],
    deps = [
        ":LlamaXPCService_lib",
        "//ext/llama_cpp",
    ],
)
