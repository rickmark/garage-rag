load("@rules_apple//apple:macos.bzl", "macos_xpc_service")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//bazel:codesign.bzl", "HARDENED_RUNTIME_CODESIGNOPTS")

# The UI tests' MockLlamaXPCService stands in for this service under the same bundle identifier,
# with the same Info.plist and entitlements.
exports_files(
    [
        "Info.plist",
        "LlamaXPCService.entitlements",
    ],
    visibility = ["//macapp/Tests/MockLlamaXPCService:__pkg__"],
)

# Implementation library for LlamaXPCService: the entry point, which puts LlamaCppEngine behind
# the shared front end in //macapp/Sources/LlamaServiceHost.
swift_library(
    name = "LlamaXPCService_lib",
    srcs = glob(["**/*.swift"]),
    module_name = "LlamaXPCService",
    visibility = ["//visibility:private"],
    deps = [
        "//macapp/Sources/LlamaEngine",
        "//macapp/Sources/LlamaServiceHost",
    ],
)

# The actual XPC service binary. It is the only target that links llama.cpp (through
# //macapp/Sources/LlamaEngine); the app and the client modules never carry the engine.
macos_xpc_service(
    name = "LlamaXPCService",
    additional_linker_inputs = [
        "//ext/python:python_framework",
        "//ext/pythonkit:PythonKit",
        "//macapp/Sources/PythonXPCService:PythonXPCService_signed",
    ],
    bundle_id = "me.rickmark.garage-rag.llama-xpc",
    bundle_name = "LlamaXPCService",
    codesignopts = HARDENED_RUNTIME_CODESIGNOPTS,
    entitlements = select({
        "//bazel:is_store": ":LlamaXPCService.entitlements",
        "//bazel:is_developer_id": "//macapp/externals:GarageAppGroup.entitlements",
        "//conditions:default": None,
    }),
    infoplists = ["Info.plist"],
    linkopts = [
        "-F$(location //ext/python:python_framework)/..",
        "-framework",
        "Python",
        "-F$(location //macapp/Sources/PythonXPCService:PythonXPCService_signed)/..",
        "-framework",
        "PythonXPCService",
    ],
    minimum_os_version = "14.0",
    version = "//macapp/Sources/GarageApp:GarageAppVersion",
    visibility = ["//visibility:public"],
    deps = [
        ":LlamaXPCService_lib",
    ],
)
