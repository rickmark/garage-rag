    name = "entry_points",
    srcs = ["entry_points.txt"],
)

py_console_script_binary(
    name = "pex",
    entry_points_txt = ":entry_points",
    pkg = "@pypi//pex:pkg",
)

py_console_script_binary(
    name = "pex3",
    entry_points_txt = ":entry_points",
