# The libpq every py_test gets through //tools/pytest:defs.bzl. The platform select lives
# here because py_pytest_test calls list() on `data`, which a select() cannot be.
filegroup(
    name = "libpq",
    testonly = True,
    srcs = select({
        "@platforms//os:macos": ["//macapp/externals:libpq"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
