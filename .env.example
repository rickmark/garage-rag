# Copy to .env and edit. All settings are optional except identity, which is
# what lets the pipeline tell your own writing apart from reference material.

# ---- database --------------------------------------------------------------
GARAGE_DATABASE_URL=postgresql+psycopg:///rag

# HNSW probe width at query time. Higher = better recall, slower.
GARAGE_HNSW_EF_SEARCH=100

# ---- identity --------------------------------------------------------------
# Your display name.
GARAGE_SELF_NAME=Your Name

# Identities that belong to you, as a JSON array of "kind:value" strings.
# kind is one of: email, git_email, git_name, phone, imessage_handle, handle
# Anything authored by an identity NOT in this list is treated as reference.
GARAGE_SELF_IDENTITIES=["git_email:you@example.com","email:you@example.com","git_name:Your Name"]

# ---- embeddings ------------------------------------------------------------
GARAGE_OLLAMA_HOST=http://localhost:11434
GARAGE_DEFAULT_EMBEDDING_MODEL=bge-m3
GARAGE_EMBED_BATCH_SIZE=64

# ---- chunking --------------------------------------------------------------
GARAGE_CHUNK_SIZE=1000
GARAGE_CHUNK_OVERLAP=150
GARAGE_CODE_CHUNK_SIZE=1200
GARAGE_CODE_CHUNK_OVERLAP=100

# Conversation windowing for communications: individual messages are too short
# to embed usefully, so consecutive messages get grouped.
GARAGE_COMMS_WINDOW_MINUTES=30
GARAGE_COMMS_WINDOW_MESSAGES=20

# ---- extraction ------------------------------------------------------------
GARAGE_MAX_FILE_BYTES=67108864
GARAGE_PDF_MIN_CHARS_PER_PAGE=32
GARAGE_OCR_MIN_CONFIDENCE=60.0

# Extraction worker processes. 10 of 16 cores leaves headroom for
# Postgres and Ollama.
GARAGE_EXTRACT_WORKERS=10

# ---- cloud OCR fallback (optional) ----------------------------------------
# When false, OCR is Tesseract-only and fully offline.
# Communications are blocked from cloud egress regardless of this setting.
GARAGE_ENABLE_CLOUD_OCR=false
GARAGE_CLOUD_OCR_MODEL=claude-opus-4-8
GARAGE_CLOUD_OCR_MAX_IMAGES=500

# Requires: uv pip install -e '.[cloud]'
# ANTHROPIC_API_KEY=sk-ant-...
