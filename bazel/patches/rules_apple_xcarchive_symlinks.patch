+def _extract_zip_preserving_symlinks(zip_file: zipfile.ZipFile, dest_dir: str) -> None:
+  """Extracts a zip file, restoring entries stored as symlinks.
+
+  `zipfile.ZipFile.extractall` ignores the Unix mode bits stored in each
+  entry's `external_attr`, so a symlink entry (as produced by `zip -y` or by
+  bundletool's own zip-merging code) is written out as a regular file whose
+  contents are the raw link-target bytes. This corrupts any bundle that
+  relies on symlinks, e.g. a versioned Python.framework's `Versions/Current`.
+  """
+  for info in zip_file.infolist():
+    extracted_path = zip_file.extract(info, dest_dir)
+    unix_mode = info.external_attr >> 16
+    if stat.S_ISLNK(unix_mode):
+      with open(extracted_path, "r") as link_file:
+        link_target = link_file.read()
+      os.remove(extracted_path)
+      os.symlink(link_target, extracted_path)
+    elif unix_mode:
+      os.chmod(extracted_path, unix_mode)
+
+
