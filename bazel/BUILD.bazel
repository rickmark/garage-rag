"""Bazel configuration: toolchains, platforms, bazelrc preset, workspace status.

(Runnable developer tooling — format, lint, gazelle — lives under //tools.)
"""

load("@bazelrc-preset.bzl", "bazelrc_preset")
load(":signing.bzl", "DEVELOPER_ID_IDENTITY", "LOCAL_SIGNING_IDENTITY", "STORE_IDENTITY")

package(default_visibility = ["//visibility:public"])

# workspace_status.sh is a stamping command (--workspace_status_command), not a
# runnable target — keep gazelle's shell extension from generating an sh_binary
# for it.
# gazelle:exclude workspace_status.sh

# Generates bazel/preset.bazelrc (imported by //.bazelrc). Regenerate with
# `bazel run //bazel:preset.update`.
bazelrc_preset(
    name = "preset",
    doc_link_template = "https://registry.build/flag/bazel?filter={flag}",
)

# Declared by the platforms below to document their signing intent. Note that
# the `is_*` config_settings below deliberately do NOT key on these: rules_apple
# rewrites --platforms to @apple_support//platforms:macos_* underneath every
# apple_* rule, which erases any constraint_value we set here. Ad-hoc is the
# default so that a plain `bazel build` never demands a signing identity.
constraint_setting(
    name = "distribution",
    default_constraint_value = ":distribution_adhoc",
)

constraint_value(
    name = "distribution_adhoc",
    constraint_setting = ":distribution",
)

constraint_value(
    name = "distribution_developer_id",
    constraint_setting = ":distribution",
)

constraint_value(
    name = "distribution_store",
    constraint_setting = ":distribution",
)

# Keyed on the signing identity build setting rather than on the :distribution
# constraint above, because a build setting survives rules_apple's platform
# transition while a constraint_value does not. Each platform below sets the
# flag; everything else falls through to //conditions:default, which is ad-hoc.
config_setting(
    name = "is_adhoc",
    flag_values = {
        "@rules_apple//apple/build_settings:signing_certificate_name": "-",
    },
)

# Local builds signed with the self-signed certificate from
# //tools/signing:local_identity. Like ad-hoc it cannot notarize or carry
# hardened runtime, but unlike ad-hoc its designated requirement is anchored to
# the certificate rather than the cdhash, so Keychain ACLs survive a rebuild.
config_setting(
    name = "is_local_signed",
    flag_values = {
        "@rules_apple//apple/build_settings:signing_certificate_name": LOCAL_SIGNING_IDENTITY,
    },
)

config_setting(
    name = "is_developer_id",
    flag_values = {
        "@rules_apple//apple/build_settings:signing_certificate_name": DEVELOPER_ID_IDENTITY,
    },
)

config_setting(
    name = "is_store",
    flag_values = {
        "@rules_apple//apple/build_settings:signing_certificate_name": STORE_IDENTITY,
    },
)

# 1. Platform for running adhoc on the local machine
platform(
    name = "local_adhoc",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
        ":distribution_adhoc",
    ],
    flags = [
        "--apple_platform_type=macos",
        "--@rules_apple//apple/build_settings:signing_certificate_name=-",
    ],
)

alias(
    name = "adhoc",
    actual = ":local_adhoc",
)

# 1b. The same local build, signed with the self-signed certificate from
# `bazel run //tools/signing:local_identity` so the app keeps one code identity
# across rebuilds. It differs from :local_adhoc in the signing flag and nothing
# else — deliberately, including the distribution constraint, which stays at its
# :distribution_adhoc default. A non-default constraint_value here would make
# this platform one the host cannot serve as an *execution* platform, and tests
# resolve a test toolchain against the target platform: that is why
# `--config=developer_id` cannot run tests, and this config is meant to be one
# somebody builds and tests with all day.
platform(
    name = "local_signed",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
    flags = [
        "--apple_platform_type=macos",
        "--@rules_apple//apple/build_settings:signing_certificate_name=" + LOCAL_SIGNING_IDENTITY,
    ],
)

alias(
    name = "macos_local_signed",
    actual = ":local_signed",
)

alias(
    name = "local",
    actual = ":local_adhoc",
)

alias(
    name = "macos_adhoc",
    actual = ":local_adhoc",
)

alias(
    name = "macos_local",
    actual = ":local_adhoc",
)

# 2. Platform for universal binary with Developer ID
platform(
    name = "universal_developer_id",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
        ":distribution_developer_id",
    ],
    flags = [
        "--apple_platform_type=macos",
        "--@rules_apple//apple/build_settings:signing_certificate_name=" + DEVELOPER_ID_IDENTITY,
    ],
)

platform(
    name = "arm_developer_id",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
        ":distribution_developer_id",
    ],
    flags = [
        "--apple_platform_type=macos",
        "--@rules_apple//apple/build_settings:signing_certificate_name=" + DEVELOPER_ID_IDENTITY,
    ],
)

alias(
    name = "developer_id",
    actual = ":universal_developer_id",
)

alias(
    name = "universal",
    actual = ":universal_developer_id",
)

alias(
    name = "macos_developer_id",
    actual = ":universal_developer_id",
)

alias(
    name = "macos_universal",
    actual = ":universal_developer_id",
)

# 3. Platform for distributing via App Store
platform(
    name = "universal_store",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
        ":distribution_store",
    ],
    flags = [
        "--apple_platform_type=macos",
        "--@rules_apple//apple/build_settings:signing_certificate_name=" + STORE_IDENTITY,
    ],
)

alias(
    name = "appstore",
    actual = ":universal_store",
)

alias(
    name = "store",
    actual = ":universal_store",
)

alias(
    name = "macos_appstore",
    actual = ":universal_store",
)

alias(
    name = "distribute_appstore",
    actual = ":universal_store",
)

# rules_apple's tree-artifact bundling, which rules_xcodeproj always turns on
# (`--define=apple.experimental.tree_artifact_outputs=1` in its bazelrc). Its bundler
# copies `framework` resources as they are rather than unpacking zips; see
# //bazel:codesign.bzl's framework_as_directory.
config_setting(
    name = "tree_artifact_outputs",
    define_values = {"apple.experimental.tree_artifact_outputs": "1"},
    visibility = ["//visibility:public"],
)
